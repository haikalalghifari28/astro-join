---
import Logo from "../images/logo.png";
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getRelativeLocaleUrl } from 'astro:i18n';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const navLinks = [
    { key: "nav.beranda", href: "/" },
    { key: "nav.tentang", href: "/tentang-kami" },
    { key: "nav.layanan", href: "/layanan" },
    { key: "nav.proyek", href: "/proyek" },
    { key: "nav.klien", href: "/klien" },
    { key: "nav.kontak", href: "/kontak" },
    { key: "nav.artikel", href: "/artikel" },
] as const;

const serviceLinks = [
    { key: "footer.service.audit", href: "/layanan/audit-struktur" },
    { key: "footer.service.desain", href: "/layanan/desain-struktur" },
    { key: "footer.service.geoteknik", href: "/layanan/geoteknik" },
    { key: "footer.service.andalalin", href: "/layanan/andalalin" },
    { key: "footer.service.rab", href: "/layanan/rab" },
] as const;
---

<style>
  .footer-link {
    color: rgb(148 163 184);
    transition: all 0.3s ease;
  }

  .footer-link:hover {
    color: white;
  }
</style>

<footer class="bg-black text-white">
  <div class="mx-auto max-w-7xl px-6 py-16 lg:px-12">

    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">

      <!-- COMPANY -->
      <section>
        <img
          src={Logo.src}
          alt="PT Join Teknologi Internasional"
          class="h-16"
        />

        <p class="mt-6 text-sm leading-relaxed text-slate-400">
          {t('footer.companyDesc')}
        </p>
      </section>

      <!-- MENU -->
      <nav aria-labelledby="footer-menu">
        <h3 id="footer-menu" class="text-lg font-semibold">
          {t('footer.navHeading')}
        </h3>

        <ul class="mt-6 space-y-3">
          {
            navLinks.map((item) => (
              <li>
                <a 
                  href={getRelativeLocaleUrl(lang, item.href)}
                  class="footer-link"
                >
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <!-- SERVICES -->
      <section>
        <h3 class="text-lg font-semibold">
          {t('footer.servicesHeading')}
        </h3>

        <ul class="mt-6 space-y-3">
          {
            serviceLinks.map((item) => (
              <li>
                <a 
                  href={getRelativeLocaleUrl(lang, item.href)}
                  class="footer-link"
                >
                  {t(item.key)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <!-- CONTACT -->
      <address class="not-italic">
        <h3 class="text-lg font-semibold">
          {t('footer.contactHeading')}
        </h3>

        <ul class="mt-6 space-y-4 text-slate-400">
          <li>{t('footer.address')}</li>

          <li>
            <a href="tel:+6281234567890" class="footer-link">
              +62 812 3456 7890
            </a>
          </li>

          <li>
            <a href="mailto:info@perusahaan.com" class="footer-link">
              info@perusahaan.com
            </a>
          </li>
        </ul>
      </address>

    </div>

  </div>

  <!-- Bottom -->
  <div class="border-t border-slate-800">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-6 text-sm text-slate-500 md:flex-row md:items-center md:justify-between lg:px-12">
      <p>
        © {new Date().getFullYear()} PT Join Teknologi Internasional. {t('footer.rights')}
      </p>
    </div>
  </div>

</footer>