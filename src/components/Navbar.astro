---
import Logo from "../images/logo.png";

const mobileMenus = [
    { label: "BERANDA", href: "#" },
    { label: "TENTANG KAMI", href: "#" },
    { label: "LAYANAN", href: "#" },
    { label: "PROYEK", href: "#" },
    { label: "KLIEN", href: "#" },
    { label: "KONTAK", href: "#" },
    { label: "ARTIKEL", href: "#" },
];

const layanan = [
    "Konstruksi Bangunan",
    "Infrastruktur Jalan",
    "Manajemen Proyek",
    "Konsultan Teknik",
];
---

<header
    id="navbar"
    class="fixed top-0 left-0 z-50 w-full transition-all duration-300"
>
    <div class="mx-auto flex h-20 max-w-7xl items-center justify-between px-5 lg:px-12">

        <!-- MOBILE LOGO -->
        <a href="/" class="lg:hidden">
            <img src={Logo.src} alt="Logo" class="h-12" />
        </a>

        <!-- DESKTOP LEFT -->
        <nav class="hidden lg:flex items-center gap-14">

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                BERANDA
            </a>

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                TENTANG KAMI
            </a>

            <!-- DROPDOWN -->
            <div class="group relative">

                <button
                    class="nav-link nav-hover flex items-center gap-2 text-sm font-semibold tracking-wide"
                >
                    LAYANAN

                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4 transition duration-300 group-hover:rotate-180"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                        />
                    </svg>
                </button>

                <!-- Dropdown -->
                <div
                    class="invisible
                    absolute
                    top-full
                    left-0
                    mt-5
                    w-72
                    rounded-2xl
                    bg-white
                    p-3
                    opacity-0
                    shadow-xl
                    transition-all
                    duration-300
                    translate-y-2
                    group-hover:visible
                    group-hover:translate-y-0
                    group-hover:opacity-100
                "
                >

                    {
                        layanan.map((item) => (
                            <a
                                href="#"
                                class="block rounded-xl px-4 py-3 text-slate-700 transition hover:bg-slate-100"
                            >
                                {item}
                            </a>
                        ))
                    }

                </div>

            </div>

        </nav>

        <!-- DESKTOP LOGO -->
        <a
            href="/"
            class="absolute left-1/2 hidden -translate-x-1/2 lg:block"
        >
            <img
                src={Logo.src}
                alt="Logo"
                class="h-16"
            />
        </a>

        <!-- DESKTOP RIGHT -->
        <nav class="hidden lg:flex items-center gap-14">

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                PROYEK
            </a>

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                KLIEN
            </a>

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                KONTAK
            </a>

            <a href="#"
                class="nav-link nav-hover text-sm font-semibold tracking-wide">
                ARTIKEL
            </a>

        </nav>

        <!-- MOBILE BUTTON -->
        <button
            id="menu-btn"
            class="lg:hidden text-white"
        >

            <svg
                id="hamburger-icon"
                xmlns="http://www.w3.org/2000/svg"
                class="h-8 w-8"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"
                />
            </svg>

        </button>

    </div>

    <!-- MOBILE MENU -->
    <div
        id="mobile-menu"
        class="hidden border-t border-slate-200 bg-white lg:hidden"
    >

        <nav class="flex flex-col py-4">

            {
                mobileMenus.map((item) => (
                    <a
                        href={item.href}
                        class="px-6 py-4 text-sm font-semibold text-slate-700 hover:bg-slate-100"
                    >
                        {item.label}
                    </a>
                ))
            }

        </nav>

    </div>
</header>

<style>
    .nav-hover {
        position: relative;
    }

    .nav-hover::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -8px;
        width: 0;
        height: 2px;
        background: #92400e;
        transition: width .3s ease;
    }

    .nav-hover:hover::after {
        width: 100%;
    }
</style>

<script>
document.addEventListener("DOMContentLoaded", () => {

    const navbar =
        document.getElementById("navbar")!;

    const menuBtn =
        document.getElementById("menu-btn")!;

    const mobileMenu =
        document.getElementById("mobile-menu")!;

    const hamburgerIcon =
        document.getElementById("hamburger-icon")!;

    if (
        !navbar ||
        !menuBtn ||
        !mobileMenu ||
        !hamburgerIcon
    ) return;

    function updateNavbar() {

        const menuOpen =
            !mobileMenu.classList.contains("hidden");

        if (window.scrollY > 0 || menuOpen) {

            navbar.classList.add(
                "bg-white",
                "shadow-md"
            );

            navbar.classList.remove(
                "bg-transparent"
            );

            document
                .querySelectorAll(".nav-link")
                .forEach((el) => {
                    el.classList.remove("text-white");
                    el.classList.add("text-slate-800");
                });

            menuBtn.classList.remove("text-white");
            menuBtn.classList.add("text-slate-800");

        } else {

            navbar.classList.remove(
                "bg-white",
                "shadow-md"
            );

            navbar.classList.add(
                "bg-transparent"
            );

            document
                .querySelectorAll(".nav-link")
                .forEach((el) => {
                    el.classList.remove("text-slate-800");
                    el.classList.add("text-white");
                });

            menuBtn.classList.remove("text-slate-800");
            menuBtn.classList.add("text-white");
        }
    }

    function updateIcon(isOpen: boolean) {

        hamburgerIcon.innerHTML = isOpen
            ? `
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M6 18L18 6M6 6l12 12"
            />
        `
            : `
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16"
            />
        `;
    }

    updateNavbar();

    window.addEventListener(
        "scroll",
        updateNavbar
    );

    menuBtn.addEventListener("click", () => {

        mobileMenu.classList.toggle("hidden");

        const isOpen =
            !mobileMenu.classList.contains("hidden");

        updateIcon(isOpen);

        updateNavbar();

    });

});
</script>