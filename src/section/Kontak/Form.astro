---
import { Icon } from "astro-icon/components";

interface Props {
  infoHeading: string;
  infoSubtitle: string;
  addressLabel: string;
  addressValue: string;
  phoneLabel: string;
  phoneValue: string;
  emailLabel: string;
  emailValue: string;
  hoursLabel: string;
  hoursValue: string;
  whatsappLabel: string;
  formHeading: string;
  formSubtitle: string;
  placeholderName: string;
  placeholderCompany: string;
  placeholderEmail: string;
  placeholderPhone: string;
  placeholderMessage: string;
  submitLabel: string;
}

const {
  infoHeading,
  infoSubtitle,
  addressLabel,
  addressValue,
  phoneLabel,
  phoneValue,
  emailLabel,
  emailValue,
  hoursLabel,
  hoursValue,
  whatsappLabel,
  formHeading,
  formSubtitle,
  placeholderName,
  placeholderCompany,
  placeholderEmail,
  placeholderPhone,
  placeholderMessage,
  submitLabel,
} = Astro.props;
---

<!-- FORM -->
<section class="bg-white py-14 md:py-24">

  <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2">

    <!-- INFO -->
    <div>

      <h2 class="text-2xl md:text-3xl font-bold text-amber-950">
        {infoHeading}
      </h2>

      <p class="mt-4 text-sm md:text-lg text-slate-600">
        {infoSubtitle}
      </p>

      <div class="mt-10 space-y-8">

        <div class="flex gap-5">
          <div class="flex h-10 w-12 md:h-14 md:w-20 items-center justify-center rounded-2xl bg-orange-500">
            <Icon name="heroicons:map-pin" class="h-5 w-5 md:h-7 md:w-7 text-white" />
          </div>

          <div>
            <h3 class="font-semibold text-sm md:text-lg text-amber-950">
              {addressLabel}
            </h3>
            <p class="mt-1 text-sm md:text-base text-slate-600">
              {addressValue}
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-orange-500">
            <Icon name="heroicons:phone" class="h-5 w-5 md:h-7 md:w-7 text-white" />
          </div>

          <div>
            <h3 class="font-semibold text-sm md:text-lg text-amber-950">
              {phoneLabel}
            </h3>
            <p class="mt-1 text-sm md:text-base text-slate-600">
              {phoneValue}
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-orange-500">
            <Icon name="heroicons:envelope" class="h-5 w-5 md:h-7 md:w-7 text-white" />
          </div>

          <div>
            <h3 class="font-semibold text-sm md:text-lg text-amber-950">
              {emailLabel}
            </h3>
            <p class="mt-1 text-sm md:text-base text-slate-600">
              {emailValue}
            </p>
          </div>
        </div>

        <div class="flex gap-5">
          <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-orange-500">
            <Icon name="heroicons:clock" class="h-5 w-5 md:h-7 md:w-7 text-white" />
          </div>

          <div>
            <h3 class="font-semibold text-sm md:text-lg text-amber-950">
              {hoursLabel}
            </h3>
            <p class="mt-1 text-sm md:text-base text-slate-600">
              <Fragment set:html={hoursValue} />
            </p>
          </div>
        </div>

        <div class="mt-10">
          <a 
            href="https://wa.me/6281376928398"
            target="_blank"
            class="inline-flex items-center gap-2 rounded-xl bg-green-600 px-6 py-2 md:px-7 md:py-3 text-xs md:text-lg font-bold tracking-wide text-white transition hover:bg-green-700"
          >
            <svg class="w-4 h-4 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            {whatsappLabel}
          </a>
        </div>

      </div>

    </div>

    <!-- FORM -->
    <div class="rounded-3xl border border-slate-200 bg-slate-50 p-8 shadow-lg">

      <h2 class="text-2xl md:text-3xl font-bold text-amber-950">
        {formHeading}
      </h2>

      <p class="mt-3 text-sm md:text-lg text-slate-600">
        {formSubtitle}
      </p>

      <form
        action="https://api.web3forms.com/submit"
        method="POST"
        class="mt-8 space-y-5"
      >

        <input type="hidden" name="access_key" value="GANTI_DENGAN_ACCESS_KEY_ANDA" />
        <input type="hidden" name="subject" value="Lead Baru Website PT Join Teknologi Internasional" />
        <input type="hidden" name="from_name" value="Website PT Join" />

        <input
          type="text"
          name="Nama Lengkap"
          placeholder={placeholderName}
          required
          class="w-full rounded-xl border border-slate-300 px-5 py-2 md:py-4 outline-none focus:border-orange-500"
        />

        <input
          type="text"
          name="Nama Perusahaan"
          placeholder={placeholderCompany}
          class="w-full rounded-xl border border-slate-300 px-5 py-2 md:py-4 outline-none focus:border-orange-500"
        />

        <input
          type="email"
          name="Email"
          placeholder={placeholderEmail}
          required
          class="w-full rounded-xl border border-slate-300 px-5 py-2 md:py-4 outline-none focus:border-orange-500"
        />

        <input
          type="text"
          name="Nomor Telepon"
          placeholder={placeholderPhone}
          required
          class="w-full rounded-xl border border-slate-300 px-5 py-2 md:py-4 outline-none focus:border-orange-500"
        />

        <textarea
          name="Pesan"
          rows="5"
          placeholder={placeholderMessage}
          required
          class="w-full rounded-xl border border-slate-300 px-5 py-4 outline-none focus:border-orange-500"
        ></textarea>

        <button
          type="submit"
          class="w-full rounded-xl bg-orange-500 px-4 py-2 md:px-6 md:py-4 font-semibold text-white transition hover:bg-orange-600"
        >
          {submitLabel}
        </button>

      </form>

    </div>

  </div>

</section>