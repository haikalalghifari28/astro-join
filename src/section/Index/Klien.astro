---
import Logo from "../../images/logo.png";

const clientsTop = [
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
];

const clientsBottom = [
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
  Logo,
];
---

<!-- STYLE -->
 <style>
  .client-marquee {
    overflow: hidden;
    position: relative;
    width: 100%;
  }

  .client-track {
    display: flex;
    width: max-content;
    gap: 5rem;
  }

  .client-item {
    flex-shrink: 0;
    width: 220px;
    height: 120px;

    display: flex;
    align-items: center;
    justify-content: center;
  }

  .client-item img {
    max-width: 180px;
    max-height: 90px;

    object-fit: contain;

    opacity: 0.8;
    transition: all 0.3s ease;
  }

  .client-item img:hover {
    opacity: 1;
    transform: scale(1.05);
  }

  .client-track-left {
    animation: marquee-left 30s linear infinite;
  }

  .client-track-right {
    animation: marquee-right 30s linear infinite;
  }

  .client-marquee:hover .client-track {
    animation-play-state: paused;
  }

  @keyframes marquee-left {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-50%);
    }
  }

  @keyframes marquee-right {
    from {
      transform: translateX(-50%);
    }

    to {
      transform: translateX(0);
    }
  }

  @media (max-width: 768px) {
    .client-item {
      width: 140px;
      height: 80px;
    }

    .client-item img {
      max-width: 100px;
      max-height: 60px;
    }

    .client-track {
      gap: 2rem;
    }
  }
</style>

<section
  id="clients"
  class="overflow-hidden bg-white py-24"
>
  <div class="mx-auto max-w-7xl px-6">

    <header class="text-center">

      <span
        class="
        text-sm
        font-semibold
        uppercase
        tracking-[0.3em]
        text-orange-500
      "
      >
        TELAH MELAYANI LEBIH DARI 500+ MITRA
      </span>

      <h2
        class="
        mt-5
        text-3xl
        font-bold
        text-slate-900
        md:text-5xl
      "
      >
        Dipercaya oleh Instansi & Perusahaan Terkemuka
      </h2>

    </header>

    <!-- ROW 1 -->
    <div class="client-marquee mt-20">

      <div class="client-track client-track-left">

        {
          [...clientsTop, ...clientsTop].map((logo) => (
            <div class="client-item">
              <img
                src={logo.src}
                alt="Client Logo"
              />
            </div>
          ))
        }

      </div>

    </div>

    <!-- ROW 2 -->
    <div class="client-marquee mt-10">

      <div class="client-track client-track-right">

        {
          [...clientsBottom, ...clientsBottom].map((logo) => (
            <div class="client-item">
              <img
                src={logo.src}
                alt="Client Logo"
              />
            </div>
          ))
        }

      </div>

    </div>

  </div>
</section>
