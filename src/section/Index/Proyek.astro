---
import Project1 from "../../images/proyek/retaining-wall/1.webp";
import Project2 from "../../images/proyek/mts/1.webp";
import Project3 from "../../images/proyek/dermaga-kendal/1.webp";
import Project4 from "../../images/proyek/jpo-polda/1.webp";
import BackgroundImage from "../../images/proyek/miting/2.webp";
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

interface ProjectItem {
  title: string;
  description: string;
}

interface StatItem {
  target: number;
  label: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  subtitle: string;
  projects: readonly ProjectItem[];
  detailLabel: string;
  viewAllLabel: string;
  statsHeading: string;
  statsItems: readonly StatItem[];
  lang: string;
}

const {
  eyebrow,
  heading,
  subtitle,
  projects,
  detailLabel,
  viewAllLabel,
  statsHeading,
  statsItems,
} = Astro.props;

// Image tidak berubah antar bahasa — tetap statis, digabung berdasarkan index
const projectImages = [Project1, Project2, Project3, Project4];

const projectsWithMedia = projects.map((item, index) => ({
  ...item,
  image: projectImages[index],
  href: getRelativeLocaleUrl(lang, '/proyek'),
}));
---

<section
  id="projects"
  class="bg-slate-50 py-14 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">

    <!-- Heading -->
    <header class="mx-auto max-w-4xl text-center">
      <span class="text-sm md:text-lg text-orange-500 font-semibold uppercase tracking-[0.3em]">
        {eyebrow}
      </span>

      <h2 class="mt-4 text-2xl md:text-4xl font-bold text-amber-950 lg:text-5xl">
        {heading}
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-sm md:text-md lg:text-lg text-slate-600">
        {subtitle}
      </p>
    </header>

    <!-- PROJECTS -->
    <div class="mt-24 space-y-28">

      {
        projectsWithMedia.map((project, index) => (

          <article
            class="
            relative
            grid
            items-center
            gap-10
            lg:grid-cols-12
            "
            data-aos="fade-up"
            data-duration="1000"
          >

            {/* IMAGE */}

            <div
              class={`
                order-1
                ${index % 2 === 0
                  ? "lg:col-span-7 lg:order-2"
                  : "lg:col-span-7 lg:order-1"}
              `}
            >
              <img
                src={project.image.src}
                alt={project.title}
                class="h-[350px] w-full object-cover shadow-xl lg:h-[520px]"
              />
            </div>

            {/* CARD */}

            <div
              class={`order-2 relative z-10 ${
                index % 2 === 0
                  ? "lg:col-span-5 lg:order-1 lg:-mr-20"
                  : "lg:col-span-5 lg:order-2 lg:-ml-20"
              }`}
            >
              <div class="bg-white p-8 shadow-2xl lg:p-12">

                <h3 class="text-xl md:text-2xl lg:text-3xl font-bold text-slate-900">
                  {project.title}
                </h3>

                <p class="text-sm md:text-md lg:text-lg mt-6 leading-relaxed text-slate-600">
                  {project.description}
                </p>

                <a 
                  href={getRelativeLocaleUrl(lang, getLocalizedPath(lang, 'projects'))}
                  class="text-sm md:text-md lg:text-lg mt-8 inline-flex items-center gap-3 font-bold uppercase tracking-wide text-orange-500 transition hover:text-orange-600"
                >
                  {detailLabel}

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </a>
              </div>
            </div>
          </article>
          

        ))
      }

    </div>

    <div class="mt-24 text-center" data-aos="fade-up" data-duration="1000">
      <a 
        href={getRelativeLocaleUrl(lang, getLocalizedPath(lang, 'projects'))}
        class="inline-flex items-center gap-3 rounded-2xl bg-orange-500 text-sm md:text-lg px-4 py-2 md:px-6 md:py-3 font-semibold text-white transition hover:bg-orange-600"
      >
        {viewAllLabel}

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>
      </a>
    </div>
  </div>
</section>

<section id="statistics" class="relative overflow-hidden">

  <!-- Background -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-fixed"
    style={`background-image:url(${BackgroundImage.src})`}
  >
    <div class="absolute inset-0 bg-black/65"></div>
  </div>

  <!-- Content -->
  <div class="relative z-10 mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-36">

    <header class="sr-only">
      <h2>{statsHeading}</h2>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 text-center text-white lg:grid-cols-4">
      {
        statsItems.map((stat) => (
          <article>
            <div
              class="counter text-4xl md:text-5xl lg:text-6xl font-light"
              data-target={stat.target}
            >
              0
            </div>

            <p class="mt-4 text-xl md:text-2xl lg:text-3xl text-white/90">
              {stat.label}
            </p>
          </article>
        ))
      }
    </div>

  </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const counters = document.querySelectorAll(".counter");

  let started = false;

  const observer = new IntersectionObserver(
    (entries) => {

      entries.forEach((entry) => {

        if (entry.isIntersecting && !started) {

          started = true;

          counters.forEach((counter) => {

            const target = Number(
              counter.getAttribute("data-target")
            );

            let current = 0;

            const increment =
              target / 80;

            const updateCounter = () => {

              current += increment;

              if (current < target) {

                counter.textContent =
                  Math.floor(current) + "+";

                requestAnimationFrame(
                  updateCounter
                );

              } else {

                counter.textContent =
                  target + "+";

              }

            };

            updateCounter();

          });

        }

      });

    },
    {
      threshold: 0.4,
    }
  );

  const section =
    document.getElementById(
      "statistics"
    );

  if (section) {
    observer.observe(section);
  }

});
</script>