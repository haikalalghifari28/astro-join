---
import Project1 from "../../images/hero.jpeg";
import Project2 from "../../images/hero.jpeg";

const projects = [
  {
    title: "Audit Struktur Gedung",
    description:
      "Kami membantu klien melakukan audit dan evaluasi struktur untuk memastikan keamanan, efisiensi, dan kepatuhan terhadap standar konstruksi yang berlaku.",
    image: Project1,
    href: "/proyek/audit-struktur",
  },
  {
    title: "Investigasi Geoteknik",
    description:
      "Melakukan pengujian dan analisis kondisi tanah untuk mendukung proses perencanaan dan pembangunan infrastruktur yang lebih akurat.",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
  {
    title: "Investigasi Geoteknik",
    description:
      "Melakukan pengujian dan analisis kondisi tanah untuk mendukung proses perencanaan dan pembangunan infrastruktur yang lebih akurat.",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
  {
    title: "Investigasi Geoteknik",
    description:
      "Melakukan pengujian dan analisis kondisi tanah untuk mendukung proses perencanaan dan pembangunan infrastruktur yang lebih akurat.",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
];
---

<section
  id="projects"
  class="bg-slate-50 py-24 lg:py-32"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">

    <!-- Heading -->
    <header class="mx-auto max-w-4xl text-center">

      <span
        class="
        text-sm
        font-semibold
        uppercase
        tracking-[0.3em]
        text-orange-500
      "
      >
        PORTOFOLIO
      </span>

      <h2
        class="
        mt-4
        text-3xl
        font-bold
        text-slate-900
        md:text-5xl
      "
      >
        Proyek Unggulan Kami
      </h2>

      <p
        class="
        mx-auto
        mt-6
        max-w-3xl
        text-lg
        text-slate-600
      "
      >
        Pengalaman kami mencakup berbagai proyek konstruksi,
        investigasi teknis, dan konsultasi yang telah membantu
        banyak perusahaan dan instansi di Indonesia.
      </p>

    </header>

    <!-- PROJECTS -->
    <div class="mt-24 space-y-28">

      {
        projects.map((project, index) => (

          <article
            class="
            relative
            grid
            items-center
            gap-10
            lg:grid-cols-12
            "
          >

            {/* IMAGE */}

            <div
              class={`
                order-1
                ${index % 2 === 0
                  ? "lg:col-span-7 lg:order-2"
                  : "lg:col-span-7 lg:order-1"}
              `}
            >
              <img
                src={project.image.src}
                alt={project.title}
                class="
                  h-[350px]
                  w-full
                  object-cover
                  shadow-xl
                  lg:h-[520px]
                "
              />
            </div>

            {/* CARD */}

            <div
              class={`
                order-2
                relative
                z-10

                ${index % 2 === 0
                  ? "lg:col-span-5 lg:order-1 lg:-mr-20"
                  : "lg:col-span-5 lg:order-2 lg:-ml-20"}
              `}
            >

              <div
                class="
                bg-white
                p-8
                shadow-2xl
                lg:p-12
                "
              >

                <h3
                  class="
                  text-3xl
                  font-bold
                  text-slate-900
                  "
                >
                  {project.title}
                </h3>

                <p
                  class="
                  mt-6
                  leading-relaxed
                  text-slate-600
                  "
                >
                  {project.description}
                </p>

                <a
                  href={project.href}
                  class="
                  mt-8
                  inline-flex
                  items-center
                  gap-3
                  font-bold
                  uppercase
                  tracking-wide
                  text-orange-500
                  transition
                  hover:text-orange-600
                  "
                >

                  Lihat Detail

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>

                </a>

              </div>

            </div>

          </article>

        ))
      }

    </div>

    <div class="mt-24 text-center">

      <a
        href="/proyek"
        class="
          inline-flex
          items-center
          gap-3
          rounded-full
          bg-amber-950
          px-8
          py-4
          font-semibold
          text-white
          transition
          hover:bg-amber-900
        "
      >
        Lihat Semua Proyek

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>

      </a>

    </div>
  </div>
</section>