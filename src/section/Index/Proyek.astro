---
import Project1 from "../../images/hero.jpeg";
import Project2 from "../../images/hero.jpeg";
import BackgroundImage from "../../images/hero.jpeg";

const projects = [
  {
    title: "Retaining Wall Jakarta",
    description:
      "Terdapat retakan pada struktur Retaining Wall. PT JTI melakukan pengujian UPV Crack untuk mengetahui kedalaman retak pada struktur beton tersebut.",
    image: Project1,
    href: "/proyek/audit-struktur",
  },
  {
    title: "Bangunan MTS",
    description:
      "Bangunan sudah berumur, dan ingin menambah lantai. PT JTI melakukan Pengujian UPV (Ultrasonic Pulse Velocity) menggunakan metode Non-Destructive Testing (NDT) yang digunakan untuk mengevaluasi mutu dan integritas beton",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
  {
    title: "Dermaga Kendal, Jawa Tengah",
    description:
      "PT JTI di tunjuk untuk mengecek struktur dermaga untuk memastikan kelayakan pada dermaga. Item pengujian yang kami lakukan adalah pengujian HAMERR TEST dan Analisis Struktur Dermaga",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
  {
    title: "JPO Polda Jakarta",
    description:
      "terjadi Pengecekan struktur bangunan berkala setaip 5 tahun sekali. Item pengujian yang digunakan adalah UPV Tes, Hammer Tes, Covermeter Tes dan Levelling verticality ",
    image: Project2,
    href: "/proyek/investigasi-geoteknik",
  },
];
---

<section
  id="projects"
  class="bg-slate-50 py-14 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-12">

    <!-- Heading -->
    <header class="mx-auto max-w-4xl text-center">

      <span
        class="
        text-sm
        md:text-lg
        text-orange-500
        font-semibold
        uppercase
        tracking-[0.3em]
      "
      >
        PORTOFOLIO
      </span>

      <h2
        class="
        mt-4
        text-2xl md:text-4xl
        font-bold
        text-amber-950
        lg:text-5xl
      "
      >
        Proyek Kami
      </h2>

      <p
        class="
        mx-auto
        mt-6
        max-w-3xl
        text-sm
        md:text-md
        lg:text-lg
        text-slate-600
      "
      >
        Pengalaman kami mencakup berbagai proyek konstruksi,
        investigasi teknis, dan konsultasi yang telah membantu
        banyak perusahaan dan instansi di Indonesia.
      </p>

    </header>

    <!-- PROJECTS -->
    <div class="mt-24 space-y-28">

      {
        projects.map((project, index) => (

          <article
            class="
            relative
            grid
            items-center
            gap-10
            lg:grid-cols-12
            "
          >

            {/* IMAGE */}

            <div
              class={`
                order-1
                ${index % 2 === 0
                  ? "lg:col-span-7 lg:order-2"
                  : "lg:col-span-7 lg:order-1"}
              `}
            >
              <img
                src={project.image.src}
                alt={project.title}
                class="
                  h-[350px]
                  w-full
                  object-cover
                  shadow-xl
                  lg:h-[520px]
                "
              />
            </div>

            {/* CARD */}

            <div
              class={`
                order-2
                relative
                z-10

                ${index % 2 === 0
                  ? "lg:col-span-5 lg:order-1 lg:-mr-20"
                  : "lg:col-span-5 lg:order-2 lg:-ml-20"}
              `}
            >

              <div
                class="
                bg-white
                p-8
                shadow-2xl
                lg:p-12
                "
              >

                <h3
                  class="
                  text-xl
                  md:text-2xl
                  lg:text-3xl
                  font-bold
                  text-slate-900
                  "
                >
                  {project.title}
                </h3>

                <p
                  class="
                  text-sm
                  md:text-md
                  lg:text-lg
                  mt-6
                  leading-relaxed
                  text-slate-600
                  "
                >
                  {project.description}
                </p>

                <a
                  href={project.href}
                  class="
                  text-sm
                  md:text-md
                  lg:text-lg
                  mt-8
                  inline-flex
                  items-center
                  gap-3
                  font-bold
                  uppercase
                  tracking-wide
                  text-orange-500
                  transition
                  hover:text-orange-600
                  "
                >

                  Lihat Detail

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>

                </a>

              </div>

            </div>

          </article>

        ))
      }

    </div>

    <div class="mt-24 text-center">

      <a
        href="/proyek"
        class="
          inline-flex
          items-center
          gap-3
          rounded-2xl
          bg-orange-500
          text-sm
          md:text-lg
          px-4
          py-2
          md:px-6
          md:py-3
          font-semibold
          text-white
          transition
          hover:bg-orange-600
        "
      >
        Lihat Semua Proyek

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          />
        </svg>

      </a>

    </div>
  </div>
</section>

<section
  id="statistics"
  class="relative overflow-hidden"
>

  <!-- Background -->
  <div
    class="absolute inset-0 bg-cover bg-center bg-fixed"
    style={`background-image:url(${BackgroundImage.src})`}
  >
    <div class="absolute inset-0 bg-black/65"></div>
  </div>

  <!-- Content -->
  <div
    class="relative z-10 mx-auto max-w-7xl px-6 py-24 lg:px-12 lg:py-36"
  >

    <header class="sr-only">
      <h2>Statistik Perusahaan</h2>
    </header>

    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-10 text-center text-white lg:grid-cols-4"
    >

      <!-- ITEM -->
      <article>

        <div
          class="counter text-4xl md:text-5xl lg:text-6xl font-light"
          data-target="100"
        >
          0
        </div>

        <p
          class="mt-4 text-xl md:text-2xl lg:text-3xl text-white/90"
        >
          Proyek
        </p>

      </article>

      <!-- ITEM -->
      <article>

        <div
          class="counter text-4xl md:text-5xl lg:text-6xl font-light"
          data-target="23"
        >
          0
        </div>

        <p
          class="mt-4 text-xl md:text-2xl lg:text-3xl text-white/90"
        >
          Kota
        </p>

      </article>

      <!-- ITEM -->
      <article>

        <div
          class="counter text-4xl md:text-5xl lg:text-6xl font-light"
          data-target="50"
        >
          0
        </div>

        <p
          class="mt-4 text-xl md:text-2xl lg:text-3xl text-white/90"
        >
          Klien
        </p>

      </article>

      <!-- ITEM -->
      <article>

        <div
          class="counter text-4xl md:text-5xl lg:text-6xl font-light"
          data-target="8"
        >
          0
        </div>

        <p
          class="mt-4 text-xl md:text-2xl lg:text-3xl text-white/90"
        >
          Tahun Pengalaman
        </p>

      </article>

    </div>

  </div>

</section>

<script>
document.addEventListener("DOMContentLoaded", () => {

  const counters = document.querySelectorAll(".counter");

  let started = false;

  const observer = new IntersectionObserver(
    (entries) => {

      entries.forEach((entry) => {

        if (entry.isIntersecting && !started) {

          started = true;

          counters.forEach((counter) => {

            const target = Number(
              counter.getAttribute("data-target")
            );

            let current = 0;

            const increment =
              target / 80;

            const updateCounter = () => {

              current += increment;

              if (current < target) {

                counter.textContent =
                  Math.floor(current) + "+";

                requestAnimationFrame(
                  updateCounter
                );

              } else {

                counter.textContent =
                  target + "+";

              }

            };

            updateCounter();

          });

        }

      });

    },
    {
      threshold: 0.4,
    }
  );

  const section =
    document.getElementById(
      "statistics"
    );

  if (section) {
    observer.observe(section);
  }

});
</script>