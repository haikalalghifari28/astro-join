const featuredArticle = articles.find(a => a.featured)!;
const gridArticles    = articles.filter(a => !a.featured);

// Format tanggal Indonesia
function formatDate(dateStr: string): string {
  return new Date(dateStr).toLocaleDateString('id-ID', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<section
  aria-labelledby="artikel-heading"
  class="pb-10 lg:pb-14 bg-white"
  itemscope
  itemtype="https://schema.org/Blog"
>
  <div class="w-full md:max-w-[85%] mx-auto px-4 sm:px-6 lg:px-8">

    <!-- ─── Section Header ──────────────────────────── -->
    <div class="mb-12">
      <h2
        id="artikel-heading"
        class="text-xl md:text-2xl lg:text-4xl font-bold text-amber-950 mb-3 leading-tight"
        itemprop="name"
      >
        Informasi Dan Berita Terbaru
      </h2>
      <p class="text-gray-700 text-sm md:text-md lg:text-lg max-w-xl leading-relaxed">
        Jelajahi artikel dan panduan terbaru dari kami untuk memahami pentingnya audit,
        sertifikasi, dan desain teknis dalam memastikan kesuksesan proyek Anda.
      </p>
    </div>

    <!-- ─── Top Row: Featured Besar + 2 Kartu Kanan ── -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-5">

      <!-- Featured Article — besar, mengisi 2/3 kolom -->
      <article
        class="lg:col-span-2 relative rounded-2xl overflow-hidden group cursor-pointer
               shadow-sm hover:shadow-xl transition-shadow duration-300 min-h-100"
        itemscope
        itemtype="https://schema.org/BlogPosting"
      >
        <a
          href={`/artikel/${featuredArticle.slug}`}
          class="block w-full h-full"
          aria-label={featuredArticle.title}
        >
          <!-- Background Image -->
          <div class="absolute inset-0">
            <img
              src={featuredArticle.coverImage}
              alt={featuredArticle.coverAlt}
              width="800"
              height="500"
              loading="eager"
              fetchpriority="high"
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              itemprop="image"
            />
            <!-- Gradient overlay -->
            <div class="absolute inset-0 bg-linear-to-t from-black/80 via-black/30 to-transparent"></div>
          </div>   

          <!-- Konten teks di bawah -->
          <div class="absolute bottom-0 left-0 right-0 p-6 z-10">
            <p class="text-white/70 text-xs uppercase tracking-widest mb-2 font-medium">
              Proses Pengajuan
            </p>
            <h3
              class="text-white text-xl md:text-2xl lg:text-3xl font-bold leading-tight mb-3
                     group-hover:text-blue-200 transition-colors"
              itemprop="headline"
            >
              {featuredArticle.title}
            </h3>
            <p class="text-white/80 text-xs md:text-sm lg:text-md leading-relaxed line-clamp-2 mb-4" itemprop="description">
              {featuredArticle.excerpt}
            </p>
          </div>
        </a>

        <!-- Hidden SEO metadata -->
        <meta itemprop="datePublished" content={featuredArticle.publishDate} />
        <meta itemprop="author" content="PT. Join Teknologi Internasional" />
      </article>

      <!-- 2 Kartu Kecil — kolom kanan -->
      <div class="flex flex-col gap-5">
        {gridArticles.slice(0, 2).map(article => (
          <article
            class="relative rounded-2xl overflow-hidden group cursor-pointer flex-1
                   shadow-sm hover:shadow-xl transition-shadow duration-300 min-h-46.25"
            itemscope
            itemtype="https://schema.org/BlogPosting"
          >
            <a
              href={`/artikel/${article.slug}`}
              class="block w-full h-full"
              aria-label={article.title}
            >
              {/* Background Image */}
              <div class="absolute inset-0">
                <img
                  src={article.coverImage}
                  alt={article.coverAlt}
                  width="400"
                  height="220"
                  loading="lazy"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  itemprop="image"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent"></div>
              </div>

              {/* Text */}
              <div class="absolute bottom-0 left-0 right-0 p-4 z-10">
                <h3
                  class="text-white text-sm md:text-md lg:text-lg font-bold leading-snug mb-3
                         group-hover:text-blue-200 transition-colors line-clamp-2"
                  itemprop="headline"
                >
                  {article.title}
                </h3>
                <div class="flex items-center justify-between">
                  <span class="inline-flex items-center gap-1.5 bg-white/20 backdrop-blur-sm
                               text-white text-[10px] font-semibold px-2.5 py-1 rounded-full
                               border border-white/30">
                    {article.category}
                  </span>
                </div>
              </div>
            </a>
            <meta itemprop="datePublished" content={article.publishDate} />
            <meta itemprop="author" content="PT. Join Teknologi Internasional" />
          </article>
        ))}
      </div>
    </div>

    <!-- ─── Bottom Row: 4 Kartu Grid ────────────────── -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-10">
      {gridArticles.slice(2).map(article => (
        <article
          class="group bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100
                 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 cursor-pointer flex flex-col"
          itemscope
          itemtype="https://schema.org/BlogPosting"
        >
          <a
            href={`/artikel/${article.slug}`}
            class="flex flex-col h-full"
            aria-label={article.title}
          >
            <!-- Image card -->
            <div class="relative overflow-hidden h-44 shrink-0">
              <img
                src={article.coverImage}
                alt={article.coverAlt}
                width="400"
                height="220"
                loading="lazy"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                itemprop="image"
              />
              <div class="absolute inset-0 bg-linear-to-t from-black/60 via-black/20 to-transparent"></div>

              <!-- Eyebrow di atas gambar -->
              <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
                <span class="text-[9px] text-white/80 uppercase tracking-widest font-medium truncate mr-2">
                  {article.category}
                </span>
              </div>
            </div>

            {/* Text */}
            <div class="p-5 flex flex-col flex-1">
              <h3
                class="text-gray-900 text-sm md:text-md lg:text-lg font-bold leading-snug mb-2 line-clamp-2
                       group-hover:text-[#1a73e8] transition-colors"
                itemprop="headline"
              >
                {article.title}
              </h3>
              <p class="text-gray-500 text-xs md:text-sm lg:text-md leading-relaxed line-clamp-3 flex-1" itemprop="description">
                {article.excerpt}
              </p>
              <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-100">
                <time
                  datetime={article.publishDate}
                  class="text-[10px] text-gray-400"
                  itemprop="datePublished"
                >
                  {formatDate(article.publishDate)}
                </time>
              </div>
            </div>
          </a>
          <meta itemprop="author" content="PT. Join Teknologi Internasional" />
        </article>
      ))}
    </div>

    <!-- Button -->
    <div>
      <a
        href="/artikel"
        class="inline-flex items-center gap-2 px-2 py-2 md:px-4 md:py-3 bg-orange-500 text-white
               font-bold text-xs md:text-sm tracking-wider rounded-lg
               hover:bg-orange-600 active:scale-95 transition-all duration-200"
        aria-label="Baca lebih banyak artikel dari PT. Join Teknologi Internasional"
      >
        Baca Lebih Banyak Artikel
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>

  </div>
</section>