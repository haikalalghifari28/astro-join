---
import { Icon } from "astro-icon/components";
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getLangFromUrl, getLocalizedPath } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);

interface ConditionItem {
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  subtitle: string;
  conditions: readonly ConditionItem[];
  ctaBadge: string;
  ctaTitle: string;
  ctaDescription: string;
  ctaButtonLabel: string;
  lang: string;
}

const {
  eyebrow,
  heading,
  subtitle,
  conditions,
  ctaBadge,
  ctaTitle,
  ctaDescription,
  ctaButtonLabel,
} = Astro.props;

// Icon tetap statis, urutannya harus sama persis dengan urutan "conditions" di home.ts
const icons = [
  "heroicons:document-check",
  "heroicons:building-office",
  "heroicons:exclamation-triangle",
  "heroicons:arrows-pointing-out",
  "heroicons:shield-check",
];

// Gabungkan icon + teks berdasarkan index
const auditConditions = conditions.map((item, index) => ({
  icon: icons[index],
  title: item.title,
  description: item.description,
}));
---

<section class="bg-slate-50 py-10 md:py-24">
  <div class="mx-auto max-w-7xl px-6">

    <!-- HEADER -->
    <header class="mx-auto max-w-4xl text-center">

      <span class="text-sm md:text-lg font-semibold uppercase tracking-[0.25em] text-orange-500">
        {eyebrow}
      </span>

      <h2 class="mt-5 text-2xl md:text-3xl lg:text-4xl font-bold leading-tight text-amber-950">
        {heading}
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-sm leading-relaxed text-slate-600 md:text-lg">
        {subtitle}
      </p>

    </header>

    <!-- GRID -->
    <div
      class="mt-16 grid gap-6 md:grid-cols-2 xl:grid-cols-3"
      data-aos="fade-up"
      data-aos-duration="1000"
    >

      {
        auditConditions.map((item) => (
          <article class="group rounded-3xl border border-slate-200 bg-white p-8 transition-all duration-300 hover:-translate-y-2 hover:border-orange-200 hover:shadow-xl">

            <div class="flex h-12 w-12 md:h-16 md:w-16 items-center justify-center rounded-2xl bg-orange-100 text-orange-600">
              <Icon name={item.icon} class="h-6 w-6 md:h-8 md:w-8" />
            </div>

            <h3 class="mt-6 text-lg md:text-xl font-bold text-amber-950">
              {item.title}
            </h3>

            <p class="mt-4 text-sm md:text-base leading-relaxed text-slate-600">
              {item.description}
            </p>

          </article>
        ))
      }

      <!-- CTA CARD -->
      <article class="relative overflow-hidden rounded-3xl bg-linear-to-br from-orange-500 to-orange-600 p-8 text-white">

        <div class="absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10"></div>

        <span class="text-sm uppercase tracking-widest">
          {ctaBadge}
        </span>

        <h3 class="mt-4 text-xl md:text-2xl font-bold">
          {ctaTitle}
        </h3>

        <p class="mt-4 text-sm md:text-base text-white/90">
          {ctaDescription}
        </p>

        <a 
          href={getRelativeLocaleUrl(lang, getLocalizedPath(lang, 'articles'))}
          class="mt-8 inline-flex items-center gap-3 rounded-full bg-white px-6 py-3 font-semibold text-orange-600 transition hover:scale-105"
        >
          {ctaButtonLabel}

          <Icon name="heroicons:arrow-right" class="h-3 w-3 md:h-5 md:w-5" />
        </a>

      </article>

    </div>

  </div>
</section>