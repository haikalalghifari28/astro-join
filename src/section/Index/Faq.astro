---
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading: string;
  subtitle: string;
  items: readonly FaqItem[];
}

const { heading, subtitle, items } = Astro.props;
---

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-item div {
    display: grid;
    grid-template-rows: 0fr;
    transition: all 0.3s ease;
  }

  .faq-item[open] div {
    grid-template-rows: 1fr;
  }
  .faq-item summary:hover h3 {
    color: #92400e;
  }
</style>

<section
  id="faq"
  aria-labelledby="faq-heading"
  class="bg-white py-14 lg:py-24"
>
  <div class="mx-auto max-w-6xl px-6">

    <!-- Heading -->
    <header class="mb-16 text-center">
      <h2
        id="faq-heading"
        class="text-xl font-bold tracking-tight text-amber-950 md:text-2xl lg:text-4xl"
      >
        {heading}
      </h2>

      <p class="mx-auto mt-6 max-w-4xl text-sm md:text-md lg:text-xl leading-relaxed text-slate-600">
        {subtitle}
      </p>
    </header>

    <!-- FAQ List -->
    <div class="space-y-0">
      {
        items.map((faq) => (
          <details class="faq-item border-t border-slate-300 py-2">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left">

              <h3 class="text-md font-semibold text-amber-950 md:text-xl">
                {faq.question}
              </h3>

              <span class="faq-icon flex h-10 w-10 items-center justify-center text-4xl font-light text-black transition-transform">
                +
              </span>

            </summary>

            <div class="max-w-5xl pb-8 pr-12">
              <p class="text-sm md:text-lg leading-relaxed text-slate-700">
                {faq.answer}
              </p>
            </div>

          </details>
        ))
      }

      <div class="border-t border-slate-300"></div>

    </div>

  </div>
</section>