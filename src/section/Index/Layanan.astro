---
import { Icon } from "astro-icon/components";

interface ServiceItem {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subtitle: string;
  services: readonly ServiceItem[];
  whyUsHeading: string;
  reasons: readonly ServiceItem[];
}

const { heading, subtitle, services, whyUsHeading, reasons } = Astro.props;

// Icon tetap statis — urutan harus sama persis dengan urutan array "services" di home.ts
const serviceIcons = [
  "heroicons:calculator",
  "heroicons:building-office-2",
  "heroicons:cog-6-tooth",
  "heroicons:wrench-screwdriver",
  "heroicons:document-check",
  "heroicons:map",
];

const reasonIcons = [
  "heroicons:academic-cap",
  "heroicons:wrench",
  "heroicons:document-text",
  "heroicons:globe-asia-australia",
];

const servicesWithIcon = services.map((item, index) => ({
  ...item,
  icon: serviceIcons[index],
}));

const reasonsWithIcon = reasons.map((item, index) => ({
  ...item,
  icon: reasonIcons[index],
}));
---

<!-- LAYANAN -->
<section id="services" class="bg-white py-14 lg:py-24">
  <div class="mx-auto max-w-7xl px-6">

    <header class="mx-auto max-w-4xl text-center">
      <h2 class="text-2xl md:text-3xl lg:text-5xl font-bold text-amber-950">
        {heading}
      </h2>

      <p class="mx-auto mt-6 max-w-3xl text-sm md:text-lg leading-relaxed text-slate-600">
        {subtitle}
      </p>
    </header>

    <div class="mt-20 grid gap-12 md:grid-cols-2">
      {
        servicesWithIcon.map((service) => (
          <article class="flex gap-6">

            <div class="flex h-20 w-20 md:h-24 md:w-24 shrink-0 items-center justify-center rounded-2xl bg-orange-100 text-orange-600">
              <Icon name={service.icon} class="h-10 w-10 md:h-14 md:w-14" />
            </div>

            <div>
              <h3 class="text-lg md:text-2xl font-bold text-amber-950">
                {service.title}
              </h3>

              <p class="mt-3 leading-relaxed text-xs md:text-md lg:text-lg text-slate-600">
                {service.description}
              </p>
            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>

<section class="bg-white pt-14 pb-24">
  <div class="mx-auto w-[85%] md:max-w-7xl px-6">

    <header class="text-center">
      <h2 class="text-2xl md:text-3xl lg:text-4xl font-bold text-amber-950">
        {whyUsHeading}
      </h2>
    </header>

    <div
      class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4"
      data-aos="fade-up"
      data-aos-duration="1000"
    >
      {
        reasonsWithIcon.map((reason) => (
          <article class="rounded-2xl bg-white p-10 text-center shadow-lg transition hover:-translate-y-2 hover:shadow-xl">

            <div class="mx-auto flex h-16 w-16 items-center justify-center text-amber-950">
              <Icon name={reason.icon} class="h-14 w-14 text-black" />
            </div>

            <div>
              <h3 class="text-lg md:text-xl lg:text-2xl mt-6 font-bold text-amber-950">
                {reason.title}
              </h3>

              <p class="mt-3 leading-relaxed text-slate-600 text-sm md:text-md lg:text-lg">
                {reason.description}
              </p>
            </div>

          </article>
        ))
      }
    </div>

  </div>
</section>