---
import { Icon } from "astro-icon/components";
const services = [
  {
    title: "Jasa Audit & Hitung Struktur Bangunan",
    description:
      "Jasa hitung struktur bangunan dengan pemodelan digital & Non-Destructive Test (NDT) untuk laporan teknis valid.",
     icon: "heroicons:calculator",
  },
  // {
  //   title: "Audit Struktur & Assessment Gedung",
  //   description:
  //     "Pengujian NDT (Non-Destructive Test), Hardness Test, dan Ultrasonic Pulse Velocity (UPV) untuk evaluasi kekuatan beton dan baja.",
  //    icon: "heroicons:clipboard-document-check",
  // },
  {
    title: "Perizinan Bangunan Gedung (PBG)",
    description:
      "Transformasi dari IMB ke PBG dengan proses yang transparan dan tepat waktu.",
    icon: "heroicons:building-office-2",
  },
  {
    title: "Perencanaan Mekanikal, Elektrikal, & Plumbing (MEP)",
    description:
      "Desain teknik mendetail mencakup sipil, ME (Mekanikal Elektrikal), dan plumbing atau MEP.",
    icon: "heroicons:cog-6-tooth",
  },
  {
    title: "Manajemen Konstruksi & Pengawasan",
    description:
      "Memastikan proyek berjalan sesuai spesifikasi teknik dan standar keselamatan.",
     icon: "heroicons:wrench-screwdriver",
  },
  {
    title: "Sertifikat Laik Fungsi (SLF)",
    description:
      "Jasa pengurusan SLF mulai dari kajian teknis hingga terbit sertifikat untuk pemenuhan regulasi pemerintah.",
    icon: "heroicons:document-check",
  },
  {
    title: "Penyelidikan Tanah & Geoteknik",
    description:
      "Sondir dan Boring untuk memastikan daya dukung pondasi bangunan.",
    icon: "heroicons:map",
  },
];

const reasons = [
    {
        title: "Tenaga Ahli Bersertifikat",
        description:
        "Tim engineer berpengalaman dengan lisensi resmi.",
        icon: "heroicons:academic-cap",
    },
    {
        title: "Peralatan Modern & Terbaru",
        description:
        "Menggunakan alat ukur kalibrasi terbaru untuk akurasi data.",
        icon: "heroicons:wrench",
    },
    {
        title: "Laporan Komprehensif",
        description:
        "Hasil audit detail yang diakui oleh instansi teknis terkait.",
        icon: "heroicons:document-text",
    },
    {
        title: "Layanan Seluruh Indonesia",
        description:
        "Berbasis di Alam Sutera, siap melayani proyek di berbagai wilayah.",
        icon: "heroicons:globe-asia-australia",
    },
];
---

<!-- LAYANAN -->
<section
  id="services"
  class="bg-white py-14 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-6">

    <header class="mx-auto max-w-4xl text-center">

      <h2
        class="text-2xl md:text-3xl lg:text-5xl font-bold text-amber-950"
      >
        Layanan Kami
      </h2>

      <p
        class="mx-auto mt-6 max-w-3xl text-sm md:text-lg leading-relaxed text-slate-600"
      >
        Sebagai konsultan teknik sipil, kami menyediakan berbagai layanan
        profesional untuk memastikan proyek berjalan optimal.
      </p>

    </header>

    <div
      class="mt-20 grid gap-12 md:grid-cols-2"
    >

      {
        services.map((service) => (

          <article
            class="flex gap-6"
          >

            <div
              class="
              flex
              h-20
              w-20
              md:h-24
              md:w-24
              shrink-0
              items-center
              justify-center
              rounded-2xl
            bg-orange-100
            text-orange-600
            "
            >
               <Icon
                name={service.icon}
                class="h-10 w-10 md:h-14 md:w-14"
              />
            </div>

            <div>

              <h3
                class="text-lg md:text-2xl font-bold text-amber-950"
              >
                {service.title}
              </h3>

              <p
                class="mt-3 leading-relaxed text-xs md:text-md lg:text-lg text-slate-600"
              >
                {service.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>

<section
  class="bg-white pt-14 pb-24"
>
  <div
    class="mx-auto w-[85%] md:max-w-7xl px-6"
  >

    <header
      class="text-center"
    >

      <h2
        class="text-2xl md:text-3xl lg:text-4xl font-bold text-amber-950"
      >
        Mengapa Memilih Kami?
      </h2>

    </header>

    <div
      class="mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4" data-aos="fade-up"
      data-aos-duration="1000"
    >

      {
        reasons.map((reason) => (

          <article
            class="
            rounded-2xl
            bg-white
            p-10
            text-center
            shadow-lg
            transition
            hover:-translate-y-2
            hover:shadow-xl
          "
          >

            <div
              class="
              mx-auto
              flex
              h-16
              w-16
              items-center
              justify-center
              text-amber-950
            "
            >
               <Icon
                name={reason.icon}
                class="h-14 w-14 text-black"
              />
            </div>

             <div>

              <h3
                class="text-lg md:text-xl lg:text-2xl mt-6 font-bold text-amber-950"
              >
                {reason.title}
              </h3>

              <p
                class="mt-3 leading-relaxed text-slate-600 text-sm md:text-md lg:text-lg"
              >
                {reason.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>