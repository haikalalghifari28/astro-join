---
import { Image } from "astro:assets";
import { sortedProjects } from "../../data/projects";
interface Props {
  button: string;
}

const { button } = Astro.props;
---

<section class="py-10 md:py-14">
    <div class="mx-auto w-[95%] px-6">

        <div id="project-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            {sortedProjects.map((project, index) => (
            <article class={`project-card ${index>= 8 ? "hidden-project hidden" : ""}`}>
                <a
                    href={`/proyek/${project.slug}/`}
                    class="group block overflow-hidden rounded-lg border border-slate-200 bg-white text-left transition hover:shadow-xl"
                    >
                    <Image src={project.cover} alt={project.title} width={800} height={600} loading="lazy" />

                    <div class="p-6">
                        <h2 class="text-base font-bold text-amber-950">
                            {project.title}
                        </h2>

                        <div class="mt-4 border-t"></div>

                        <div class="mt-4 flex items-center justify-between gap-4">
                            <p class="line-clamp-2 text-sm text-slate-600">
                                {project.description}
                            </p>

                            <span class="shrink-0 text-sm text-slate-500">
                                {project.location}, {project.year}
                            </span>
                        </div>
                    </div>
                </a>
            </article>
            ))}
        </div>

        <div class="mt-12 text-center">

            <button id="load-more"
                class="
                    rounded-full
                    bg-orange-500
                    px-4
                    py-2
                    md:px-6
                    md:py-3
                    font-semibold
                    text-white
                    transition
                    hover:bg-orange-600
                  ">
                {button}
            </button>

        </div>

    </div>
</section>

<script>
    let visible = 8;

    const cards = document.querySelectorAll(".hidden-project");

    document
        .getElementById("load-more")
        ?.addEventListener("click", () => {

            for (
                let i = visible - 8; i < visible; i++
            ) {
                cards[i]?.classList.remove("hidden");
            }

            visible += 8;

            if (visible > cards.length + 8) {
                document
                    .getElementById("load-more")
                    ?.remove();
            }
        });
</script>