---

<section class="py-10 md:py-14">
  <div class="mx-auto w-[95%] px-6">

    <div
      id="project-grid"
      class="grid gap-8 md:grid-cols-2 lg:grid-cols-4"
    >

      {
        projects.map((project, index) => (

          <article
            class={`project-card ${
              index >= 8 ? "hidden-project hidden" : ""
            }`}
          >

            <button
              class="
                group
                overflow-hidden
                rounded-lg
                border
                border-slate-200
                bg-white
                text-left
                transition
                hover:shadow-xl
              "
              data-project={JSON.stringify({
              id: project.id,
              title: project.title,
              description: project.description,
              location: project.location,
              year: project.year,
              category: project.category,
              images: project.gallery.map(img => img.src),
        })}
            >

              <Image
                src={project.cover}
                alt={project.title}
                width={800}
                height={600}
                loading="lazy"
              />

              <div class="p-6">

                <h2
                  class="text-xl font-bold text-amber-950"
                >
                  {project.title}
                </h2>

                <div
                  class="mt-4 border-t"
                ></div>

                <div
                  class="
                    mt-4
                    flex
                    items-center
                    justify-between
                    gap-4
                  "
                >

                  <p
                    class="line-clamp-2 text-sm md:text-base text-slate-600"
                  >
                    {project.description}
                  </p>

                  <span
                    class="shrink-0 text-sm text-slate-500"
                  >
                    {project.location}, {project.year}
                  </span>

                </div>

              </div>

            </button>

          </article>

        ))
      }

    </div>

    <div
      class="mt-12 text-center"
    >

      <button
        id="load-more"
        class="
          rounded-full
          bg-orange-500
          px-5
          py-2
          md:px-8
          md:py-4
          font-semibold
          text-white
          transition
          hover:bg-orange-600
        "
      >
        {button}
      </button>

    </div>

  </div>
</section>

  <!-- Modal -->
  <div
    id="project-modal"
    class="
      fixed
      inset-0
      z-9999
      hidden
      bg-black/70
      md:p-20
    "
  >

    <div
      class="
        mx-auto
        mt-10
        w-full
        md:max-w-7xl
        rounded-3xl
        bg-white
        p-8
      "
    >

      <button
        id="close-modal"
        class="ml-auto block text-3xl"
      >
        ×
      </button>

      <div
        class="
          mt-4
          grid
          gap-10
          lg:grid-cols-2
        "
      >

        <!-- LEFT -->
        <div class="space-y-4">

          <div>

            <h2
              id="modal-title"
              class="
                text-xl
                md:text-2xl
                lg:text-4xl
                font-bold
                text-amber-950
              "
            ></h2>

            <div class="mt-4 border-t"></div>

          </div>

          <p
            id="modal-description"
            class="
              text-xs
              md:text-sm
              lg:text-base
              leading-relaxed
              text-slate-800
            "
          ></p>

          <div class="text-sm md:text-lg italic">

            <p>
              <span id="modal-category"></span> - <span id="modal-location"></span>, <span id="modal-year"></span>
            </p>

          </div>

        </div>

        <!-- RIGHT -->
        <div>

          <div
            class="relative"
          >

            <img
              id="modal-image"
              class="
                h-60
                md:h-125
                w-full
                rounded-2xl
                object-cover
              "
            />

            <button
              id="prev-image"
              class="
                absolute
                left-4
                top-1/2
                -translate-y-1/2
                z-20
                flex
                h-8
                w-8
                md:h-12
                md:w-12
                items-center
                justify-center
                rounded-full
                bg-white
                shadow-lg
              "
            >
              ←
            </button>

            <button
              id="next-image"
              class="
                absolute
                right-4
                top-1/2
                -translate-y-1/2
                z-20
                flex
                h-8
                w-8
                md:h-12
                md:w-12
                items-center
                justify-center
                rounded-full
                bg-white
                shadow-lg
              "
            >
              →
            </button>

          </div>

        </div>

      </div>

    </div>

  </div>


<!-- Script -->
<script>
  let visible = 8;

  const cards = document.querySelectorAll(".hidden-project");

  document
    .getElementById("load-more")
    ?.addEventListener("click", () => {

      for (
        let i = visible - 8;
        i < visible;
        i++
      ) {
        cards[i]?.classList.remove("hidden");
      }

      visible += 8;

      if (visible > cards.length + 8) {
        document
          .getElementById("load-more")
          ?.remove();
      }
    });

  const modal =
    document.getElementById("project-modal");

  let currentImages: string[] = [];
  let currentIndex = 0;

  document
    .querySelectorAll("[data-project]")
    .forEach((item) => {

      item.addEventListener("click", () => {

        const data = JSON.parse(
          item.dataset.project
        );

        document.getElementById(
          "modal-title"
        ).textContent = data.title;

        document.getElementById(
          "modal-description"
        ).textContent = data.description;

        document.getElementById(
          "modal-location"
        ).textContent = data.location;

        document.getElementById(
          "modal-year"
        ).textContent = data.year;

        document.getElementById(
          "modal-category"
        ).textContent = data.category;

        currentImages = data.images;

        currentIndex = 0;

        document.getElementById(
          "modal-image"
        ).src = currentImages[0];

        modal.classList.remove("hidden");
      });
    });

  document
    .getElementById("close-modal")
    ?.addEventListener("click", () => {
      modal.classList.add("hidden");
    });

  document
    .getElementById("next-image")
    ?.addEventListener("click", () => {

      currentIndex =
        (currentIndex + 1) %
        currentImages.length;

      document.getElementById(
        "modal-image"
      ).src = currentImages[currentIndex];
    });

  document
    .getElementById("prev-image")
    ?.addEventListener("click", () => {

      currentIndex =
        (currentIndex - 1 +
          currentImages.length) %
        currentImages.length;

      document.getElementById(
        "modal-image"
      ).src = currentImages[currentIndex];
    });
</script>