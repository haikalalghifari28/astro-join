---
import Dprd from "../../images/dprd.jpeg";
import Bumn from "../../images/bumn.webp";
import Manufaktur from "../../images/manufaktur.webp";
import Properti from "../../images/properti.jpg";
import Rs from "../../images/rs.jpeg";
import Univ from "../../images/univ.webp";
import Perkantoran from "../../images/perkantoran.jpg";
import Pabrik from "../../images/pabrik.jpg";

interface SectorItem {
  title: string;
  description: string;
}

interface Props {
  eyebrow: string;
  heading: string;
  subtitle: string;
  items: readonly SectorItem[];
}

const { eyebrow, heading, subtitle, items } = Astro.props;

// Image tetap statis — urutan harus sama persis dengan urutan array "items" di klien.ts
const sectorImages = [Dprd, Bumn, Manufaktur, Properti, Rs, Univ, Perkantoran, Pabrik];

const sectors = items.map((item, index) => ({
  ...item,
  image: sectorImages[index],
}));
---

<section class="py-20 lg:py-28 bg-slate-50">

    <div class="mx-auto w-[90%] px-6">

        <header class="mx-auto max-w-3xl text-center">

            <span class="font-semibold uppercase tracking-[0.3em] text-orange-500 text-sm md:text-md lg:text-lg">
                {eyebrow}
            </span>

            <h2 class="mt-4 text-2xl font-bold text-amber-950 md:text-4xl">
                {heading}
            </h2>

            <p class="mt-6 text-slate-600 text-sm md:text-lg max-w-3xl">
                {subtitle}
            </p>

        </header>

        <div class="mt-14 grid gap-8 md:grid-cols-2 xl:grid-cols-4">

            {
              sectors.map((sector) => (
                <article
                    class="group overflow-hidden rounded-3xl bg-white shadow-lg transition duration-700  hover:shadow-2xl"
                    data-aos="fade-up"
                    data-aos-duration="1000"
                >

                    <div class="overflow-hidden">
                        <img
                            src={sector.image.src}
                            alt={sector.title}
                            loading="lazy"
                            class="h-56 w-full object-cover transition duration-700 group-hover:scale-110"
                        />
                    </div>

                    <div class="p-8">
                        <h3 class="text-lg md:text-xl lg:text-2xl font-bold text-amber-950">
                            {sector.title}
                        </h3>

                        <p class="mt-4 text-sm md:text-base leading-relaxed text-slate-600">
                            {sector.description}
                        </p>
                    </div>

                </article>
              ))
            }

        </div>

    </div>

</section>