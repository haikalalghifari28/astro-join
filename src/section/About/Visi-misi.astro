---
import { Icon } from "astro-icon/components";

interface Props {
  visiLabel: string;
  visiTitle: string;
  visiDescription: string;
  misiLabel: string;
  misiTitle: string;
  misiDescription: string;
}

const {
  visiLabel,
  visiTitle,
  visiDescription,
  misiLabel,
  misiTitle,
  misiDescription,
} = Astro.props;
---

<section class="bg-[#382d26] py-10 md:py-24 text-amber-950">
  <div class="mx-auto grid max-w-7xl gap-12 px-6 lg:grid-cols-2">

    <!-- VISI -->
    <article
      class="rounded-3xl bg-slate-100 p-10 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
      data-aos="fade-right"
      data-aos-duration="1000"
    >
      <div class="flex items-start justify-between">
        <div>
          <span class="text-orange-400 font-bold text-sm md:text-lg lg:text-xl">
            {visiLabel}
          </span>

          <h2 class="mt-4 text-xl md:text-2xl lg:text-3xl font-bold">
            {visiTitle}
          </h2>
        </div>

        <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-orange-500">
          <Icon name="heroicons:eye" class="h-5 w-5 md:h-7 md:w-7 text-white" />
        </div>
      </div>

      <p class="mt-6 leading-relaxed text-slate-600 text-sm md:text-md lg:text-lg">
        {visiDescription}
      </p>
    </article>

    <!-- MISI -->
    <article
      class="rounded-3xl bg-slate-100 p-10 transition duration-300 hover:-translate-y-2 hover:shadow-xl"
      data-aos="fade-left"
      data-aos-duration="1000"
    >
      <div class="flex items-start justify-between">
        <div>
          <span class="text-orange-400 font-bold text-sm md:text-lg lg:text-xl">
            {misiLabel}
          </span>

          <h2 class="mt-4 text-xl md:text-2xl lg:text-3xl font-bold">
            {misiTitle}
          </h2>
        </div>

        <div class="flex h-10 w-10 md:h-14 md:w-14 items-center justify-center rounded-2xl bg-orange-500">
          <Icon name="heroicons:shield-check" class="h-5 w-5 md:h-7 md:w-7 text-white" />
        </div>
      </div>

      <p class="mt-6 leading-relaxed text-slate-600 text-sm md:text-md lg:text-lg">
        {misiDescription}
      </p>
    </article>

  </div>
</section>