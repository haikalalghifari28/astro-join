---
interface ExpertiseItem {
  title: string;
  description: string;
}

interface Props {
  heading: string;
  subtitle: string;
  items: readonly ExpertiseItem[];
}

const { heading, subtitle, items } = Astro.props;
---

<section class="bg-slate-50 py-18 lg:py-24">

  <div class="mx-auto max-w-7xl px-6">

    <header class="text-center">
      <h2 class="text-2xl font-bold text-amber-950 md:text-4xl">
        {heading}
      </h2>
      <p class="mx-auto mt-6 text-sm md:text-lg max-w-3xl text-slate-600">
        {subtitle}
      </p>
    </header>

    <div class="mt-14 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        items.map((item) => (
          <article class="transition hover:-translate-y-2 hover:shadow-xl rounded-3xl bg-white p-10 shadow-lg">

            <h3 class="text-xl md:text-2xl font-bold text-amber-950">
              {item.title}
            </h3>

            <p class="mt-4 text-sm md:text-md lg:text-lg leading-relaxed text-slate-600">
              {item.description}
            </p>

          </article>
        ))
      }
    </div>

  </div>

</section>