---

<!-- LAYANAN -->
<section
  id="services"
  class="bg-white py-14 lg:py-24"
>
  <div class="mx-auto max-w-7xl px-6">

    <header class="mx-auto max-w-4xl text-center">

      <h2
        class="text-2xl md:text-3xl lg:text-5xl font-bold text-amber-950"
      >
        Layanan Kami
      </h2>

      <p
        class="mx-auto mt-6 max-w-3xl text-sm md:text-lg leading-relaxed text-slate-600"
      >
        Sebagai konsultan teknik sipil, kami menyediakan berbagai layanan
        profesional untuk memastikan proyek berjalan optimal.
      </p>

    </header>

    <div
      class="mt-20 grid gap-12 md:grid-cols-2"
    >

      {
        services.map((service) => (

          <article
            class="flex gap-6"
          >

            <div
              class="
              flex
              h-20
              w-20
              md:h-24
              md:w-24
              shrink-0
              items-center
              justify-center
              rounded-2xl
            bg-orange-100
            text-orange-600
            "
            >
               <Icon
                name={service.icon}
                class="h-10 w-10 md:h-14 md:w-14"
              />
            </div>

            <div>

              <h3
                class="text-lg md:text-2xl font-bold text-amber-950"
              >
                {service.title}
              </h3>

              <p
                class="mt-3 leading-relaxed text-xs md:text-md lg:text-lg text-slate-600"
              >
                {service.description}
              </p>

            </div>

          </article>

        ))
      }

    </div>

  </div>
</section>




