---
import "aos/dist/aos.css";
import { getLangFromUrl, getRouteKeyFromPath, getHreflangAlternates } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jasa Konsultan Bangunan & Audit Struktur Terpercaya | PT Join Teknologi Internasional",
  description = "Jasa konsultan bangunan profesional: audit struktur, desain struktur, investigasi geoteknik, dan manajemen konstruksi terpercaya di Indonesia.",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const rawPath = Astro.url.pathname.replace(/^\/en/, '') || '/';
const routeKey = getRouteKeyFromPath(rawPath);
const alternates = getHreflangAlternates(Astro.url, routeKey);
const canonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).toString();
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Hreflang: memberi tahu Google versi bahasa lain dari halaman ini -->
		{alternates.map((alt) => (
			<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
		))}

		<!-- Open Graph -->
		<meta property="og:locale" content={lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
	</head>
	<body>
		<slot />
		<script>
			import("aos").then(({ default: AOS }) => {
				AOS.init({
				duration: 800,
				once: true,
				easing: "ease-out-cubic",
				offset: 80,
				});
			});
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>