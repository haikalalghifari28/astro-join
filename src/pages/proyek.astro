---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
import { Icon } from 'astro-icon/components'
import Navbar from '../components/Navbar.astro';
import Hero from '../section/Proyek/Hero.astro';
import ProyekSection from '../section/Proyek/Proyek.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, usePageTranslations } from '../i18n/utils';
import { proyek } from '../i18n/pages/proyek';

const lang = getLangFromUrl(Astro.url);
const t = usePageTranslations(proyek, lang);
---

<Layout title={t.meta.title} description={t.meta.description}>
	<Navbar />
	<Hero
        eyebrow={t.hero.eyebrow}
        title={t.hero.title}
        subtitle={t.hero.subtitle}
    />
	<ProyekSection button={t.proyekSection.button} />
	<Footer />
</Layout>
