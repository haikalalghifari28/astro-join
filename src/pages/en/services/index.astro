---
import Layout from '../../../layouts/Layout.astro';
import '../../../styles/global.css';
import Navbar from '../../../components/Navbar.astro';
import Hero from '../../../section/Layanan/Hero.astro';
import Keahlian from '../../../section/Layanan/Keahlian.astro';
import LayananGrid from '../../../section/Index/Layanan.astro';
import Cta from '../../../section/Index/Cta.astro';
import Footer from '../../../components/Footer.astro';
import { getLangFromUrl, usePageTranslations } from '../../../i18n/utils';
import { service } from '../../../i18n/pages/service';
import { home } from '../../../i18n/pages/home';

const lang = getLangFromUrl(Astro.url);
const t = usePageTranslations(service, lang);
const tHome = usePageTranslations(home, lang);
---

<Layout title={t.meta.title} description={t.meta.description}>
	<Navbar />
	<Hero
        eyebrow={t.hero.eyebrow}
        title={t.hero.title}
        subtitle={t.hero.subtitle}
    />
	<Keahlian
		heading={t.keahlian.heading}
		subtitle={t.keahlian.subtitle}
		items={t.keahlian.items}
	/>
	<LayananGrid
		heading={tHome.layananSection.heading}
		subtitle={tHome.layananSection.subtitle}
		services={tHome.layananSection.services}
		whyUsHeading={tHome.layananSection.whyUsHeading}
		reasons={tHome.layananSection.reasons}
	/>
	<Cta
		heading={tHome.ctaSection.heading}
		description={tHome.ctaSection.description}
		buttonLabel={tHome.ctaSection.buttonLabel}
	/>
	<Footer />
</Layout>