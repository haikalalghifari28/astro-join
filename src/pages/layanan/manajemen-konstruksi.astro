---
import HeroImage from "../../images/hero.jpeg";
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const process = [
  {
    title: "Quality Control",
    description:
      "Memeriksa kualitas material bangunan yang masuk ke lokasi proyek.",
  },
  {
    title: "Progress Monitoring",
    description:
      "Pengawasan jadwal kerja (S-Curve) agar proyek selesai tepat waktu.",
  },
  {
    title: "Cost Management",
    description:
      "Verifikasi tagihan kontraktor berdasarkan hasil pekerjaan nyata di lapangan.",
  },
  {
    title: "Reporting",
    description:
      "Laporan harian, mingguan, dan bulanan yang komprehensif untuk pemilik proyek.",
  },
];

const faqs = [
  {
    question: "Kapan saya harus menggunakan jasa manajemen kontruksi?",
    answer:
      "Disarankan sejak tahap awal tender kontraktor hingga serah terima hasil pekerjaan.",
  },
  {
    question: "Apakah pengawas PT. JTI berhak menghentikan pekerjaan kontraktor?",
    answer:
      "Ya, jika ditemukan metode kerja yang membahayakan struktur atau tidak sesuai spek.",
  },
  {
    question: "Bagaimana cara PT. JTI memantau proyek yang lokasinya jauh?",
    answer:
      "Kami menempatkan tim resident engineer di lokasi dan menyediakan laporan digital yang dapat diakses pemilik kapan saja.",
  },
  {
    question:
      "Apakah manajemen kontruksi mencakup pengawasan K3?",
    answer:
      "Ya, keselamatan kerja adalah prioritas utama dalam setiap pengawasan yang kami lakukan di lapangan.",
  },
];
---

<Layout>
    <Navbar />
    <!-- HERO -->
    <section class="relative h-140 lg:h-170 overflow-hidden">

    <!-- Background Image -->
    <img
        src={HeroImage.src}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/70"></div>

    <!-- Content -->
    <div
        class="relative z-10 flex h-full items-center justify-start"
    >
        <div class="mx-10 lg:mx-40 max-w-5xl px-6 text-left text-white">

        <h1
            class="text-[27px] font-bold leading-tight md:text-4xl lg:text-5xl"
        >
        Jasa Manajemen Konstruksi & Pengawasan
        </h1>

        <p
            class="mt-8 max-w-3xl text-sm leading-relaxed text-white/90 md:text-xl"
        >
        Menyediakan layanan Jasa Manajemen Kontruksi & Pengawasan untuk memastikan keamanan dan kelayakan bangunan Anda.

        </p>

        </div>
    </div>

    </section>

    <!-- APA ITU PBG -->
    <section class="bg-white py-20 lg:py-28">
        <div
            class="mx-auto max-w-7xl px-6"
        >

            <div class="
                grid
                gap-14
                lg:grid-cols-2
                lg:items-center
            "
            >

              <!-- LEFT -->
              <div>

                  <span
                  class="
                      text-sm md:text-base lg:text-lg
                      font-semibold
                      uppercase
                      tracking-[0.25em]
                      text-orange-500
                  "
                  >
                  Layanan Manajemen Konstruksi & Pengawasan
                  </span>

                  <h1
                  class="
                      mt-4
                      text-xl
                      md:text-2xl
                      lg:text-4xl
                      font-bold
                      leading-tight
                      text-amber-950
                  "
                  >
                  Manajemen Konstruksi & Pengawasan
                  </h1>

                  <p
                  class="
                      mt-8
                      text-sm
                      leading-relaxed
                      text-slate-600
                      md:text-md
                      lg:text-lg
                  "
                  >
                 Layanan Pengawasan (Manajemen Konstruksi) bertujuan untuk memastikan pelaksanaan pembangunan di lapangan berjalan sesuai dengan rencana teknis (DED), anggaran (RAB), dan standar kualitas yang telah ditetapkan sebelumnya.
                  </p>
                  <p
                  class="
                      mt-8
                      text-sm
                      leading-relaxed
                      text-slate-600
                      md:text-md
                      lg:text-lg
                  "
                  >
                  Manfaat yang anda dapatkan dari layanan manajemen konstruksi adalah Kualitas bangunan terjaga sesuai spesifikasi kontrak, Menghindari pembengkakan biaya akibat kesalahan kerja kontraktor, 
                  Ketepatan waktu penyelesaian proyek yang terjamin.
                  </p>

              </div>

              <!-- RIGHT -->
              <div class="relative">
                  <article
                      class="
                        rounded-4xl
                        bg-white
                        p-8
                        shadow-sm
                        lg:p-10
                      "
                    >

                      <h3
                        class="
                          text-lg
                          md:text-xl
                          lg:text-2xl
                          font-bold
                          text-amber-950
                        "
                      >
                        Proses & Metodologi Kami
                      </h3>

                      <div
                        class="
                          mt-10
                          space-y-8
                        "
                      >

                        {
                          process.map((item, index) => (

                            <div
                              class="
                                relative
                                pl-16
                              "
                            >

                              {
                                index !== process.length - 1 && (
                                  <div
                                    class="
                                      absolute
                                      left-[18px]
                                      top-12
                                      h-full
                                      w-px
                                      bg-orange-200
                                    "
                                  ></div>
                                )
                              }

                              <div
                                class="
                                  absolute
                                  left-0
                                  top-0
                                  flex
                                  h-9
                                  w-9
                                  items-center
                                  justify-center
                                  rounded-full
                                  bg-orange-500
                                  text-sm
                                  font-bold
                                  text-white
                                "
                              >
                                {index + 1}
                              </div>

                              <h4
                                class="
                                  text-base
                                  md:text-lg
                                  lg:text-xl
                                  font-semibold
                                  text-amber-950
                                "
                              >
                                {item.title}
                              </h4>

                              <p
                                class="
                                  mt-2
                                  text-sm
                                  md:text-base
                                  leading-relaxed
                                  text-slate-600
                                "
                              >
                                {item.description}
                              </p>

                            </div>

                          ))
                        }

                      </div>

                    </article>
                                
              </div>

            </div>

        </div>
    </section>


    <!-- FAQ STYLE -->
    <style>
  .faq-item summary::-webkit-details-marker {
  display: none;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
  }
  .faq-item div {
    display: grid;
    grid-template-rows: 0fr;
    transition: all 0.3s ease;
  }

  .faq-item[open] div {
    grid-template-rows: 1fr;
  }
  .faq-item summary:hover h3 {
    color: #92400e;
  }
    </style>

    <!-- FAQ -->
    <section
      id="faq"
      aria-labelledby="faq-heading"
      class="bg-slate-50 py-14 lg:py-24"
    >
      <div class="mx-auto max-w-6xl px-6">

        <!-- Heading -->
        <header class="mb-16 text-center">

          <h2
            id="faq-heading"
            class="
              text-xl
              font-bold
              tracking-tight
              text-amber-950
              md:text-2xl
              lg:text-4xl
            "
          >
            Pertanyaan Umum Seputar
            Perencanaan MEP
          </h2>

          <p
            class="
              mx-auto
              mt-6
              max-w-4xl
              text-sm
              md:text-md
              lg:text-xl
              leading-relaxed
              text-slate-600
            "
          >
            Pertanyaan yang umum ditanyakan oleh klien terkait perencanaan MEP
          </p>

        </header>

        <!-- FAQ List -->
        <div class="space-y-0">

          {
            faqs.map((faq) => (
              <details
                class="
                  faq-item
                  border-t
                  border-slate-300
                  py-2
                "
              >
                <summary
                  class="
                    flex
                    cursor-pointer
                    list-none
                    items-center
                    justify-between
                    gap-6
                    py-6
                    text-left
                  "
                >

                  <h3
                    class="
                      text-md
                      font-semibold
                      text-amber-950
                      md:text-xl
                    "
                  >
                    {faq.question}
                  </h3>

                  <span
                    class="
                      faq-icon
                      flex
                      h-10
                      w-10
                      items-center
                      justify-center
                      text-4xl
                      font-light
                      text-black
                      transition-transform
                    "
                  >
                    +
                  </span>

                </summary>

                <div
                  class="
                    max-w-5xl
                    pb-8
                    pr-12
                  "
                >
                  <p
                    class="
                      text-sm
                      md:text-lg
                      leading-relaxed
                      text-slate-700
                    "
                  >
                    {faq.answer}
                  </p>
                </div>

              </details>
            ))
          }

          <div class="border-t border-slate-300"></div>

        </div>

      </div>
    </section>

    <!-- CTA -->
    <section
    class="
        bg-white
        py-14
        md:py-24
        text-center
        text-amber-950
    "
    >

    <div
        class="
        mx-auto
        max-w-4xl
        px-6
        "
    >

        <h2
        class="
            text-2xl
            font-bold
            md:text-3xl
            lg:text-5xl
        "
        >
        Masih Punya Pertanyaan?
        </h2>

        <p
        class="
            mt-6
            text-md
            md:text-lg
            lg:text-xl
            text-slate-700
        "
        >
        Hubungi kami untuk konsultasi kebutuhan Anda, <b>Gratis!</b>
        </p>

        <a
            href="https://wa.me/6281376928398"
            target="_blank"
            class="inline-flex mt-10 items-center gap-2 rounded-full bg-green-600 px-6 py-2 md:px-7 md:py-3 text-xs md:text-lg font-bold tracking-wide text-white transition hover:bg-green-700"
        >
            <!-- WhatsApp icon SVG -->
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
            </svg>
            Konsultasi
        </a>

    </div>

    </section>
    <Footer />
</Layout>