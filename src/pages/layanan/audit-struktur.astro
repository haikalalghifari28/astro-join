---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { Icon } from 'astro-icon/components'
import HeroImage from "../../images/proyek/bi-serang/4.webp";
import AboutImage from "../../images/proyek/bi-serang/6.webp";
import HasilEtabs1 from "../../images/proyek/hasil-etabs/1.webp";
import HasilEtabs2 from "../../images/proyek/hasil-etabs/2.webp";
import HasilEtabs3 from "../../images/proyek/hasil-etabs/3.webp";
import HasilEtabs4 from "../../images/proyek/hasil-etabs/4.webp";
import Upv from "../../images/upv.jpeg";
import Gpr from "../../images/gpr.jpg";
import Thermal from "../../images/thermal.webp";
import Etabs from "../../images/etabs.webp";
import { Image } from "astro:assets";
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

import { getLangFromUrl, usePageTranslations } from '../../i18n/utils';
import { auditStruktur } from '../../i18n/pages/layanan/audit-struktur';
const lang = getLangFromUrl(Astro.url);
const t = usePageTranslations(auditStruktur, lang);

// Icon statis, digabung berdasarkan index
const reasonIcons = ["heroicons:shield-check", "heroicons:building-office", "heroicons:magnifying-glass", "heroicons:scale"];
const reasons = t.whyImportant.items.map((item, i) => ({ ...item, icon: reasonIcons[i] }));

const advantageIcons = ["heroicons:shield-check", "heroicons:shield-check", "heroicons:shield-check", "heroicons:shield-check", "heroicons:shield-check"];
const workflow = t.advantages.items.map((item, i) => ({ ...item, icon: advantageIcons[i] }));

// Image statis, digabung berdasarkan index
const testImages = [HasilEtabs1, HasilEtabs2, HasilEtabs3, HasilEtabs4];
const testingImages = testImages.map((img, i) => ({ image: img, alt: t.testing.imageAlts[i] }));

const techImages = [Upv, Gpr, Etabs, Thermal];
const technologies = t.technologies.items.map((item, i) => ({ ...item, image: techImages[i] }));


---

<Layout title={t.meta.title} description={t.meta.description}>
	<Navbar />

    <!-- HERO -->
    <section class="relative h-140 lg:h-170 overflow-hidden">
        <img src={HeroImage.src} alt="" class="absolute inset-0 h-full w-full object-cover" />
        <div class="absolute inset-0 bg-black/70"></div>

        <div class="relative z-10 flex h-full items-center justify-start">
            <div class="mx-10 lg:mx-40 max-w-5xl px-6 text-left text-white">
                <h1 class="text-[27px] font-bold leading-tight md:text-4xl lg:text-5xl">
                    <Fragment set:html={t.hero.title} />
                </h1>
                <p class="mt-8 max-w-3xl text-sm leading-relaxed text-white/90 md:text-xl">
                    {t.hero.subtitle}
                </p>
            </div>
        </div>
    </section>

    <!-- APA ITU AUDIT STRUKTUR -->
    <section class="bg-white py-20 lg:py-28">
        <div class="mx-auto max-w-7xl px-6">
            <div class="grid gap-14 lg:grid-cols-2 lg:items-center">

                <div>
                    <span class="text-sm md:text-base lg:text-lg font-semibold uppercase tracking-[0.25em] text-orange-500">
                        {t.intro.eyebrow}
                    </span>

                    <h2 class="mt-4 text-xl md:text-2xl lg:text-4xl font-bold leading-tight text-amber-950">
                        {t.intro.heading}
                    </h2>

                    <p class="mt-8 text-sm leading-relaxed text-slate-600 md:text-md lg:text-lg">
                        {t.intro.paragraph1}
                    </p>

                    <p class="mt-6 text-base leading-relaxed text-slate-600 md:text-lg">
                        {t.intro.paragraph2}
                    </p>
                </div>

                <div class="relative">
                    <div class="absolute -bottom-6 -left-6 h-full w-full rounded-3xl bg-orange-50"></div>
                    <Image
                        src={AboutImage}
                        alt={t.intro.heading}
                        width={1000}
                        loading="eager"
                        class="relative z-10 rounded-3xl object-cover shadow-2xl"
                    />
                </div>

            </div>
        </div>
    </section>

    <!-- MENGAPA PENTING -->
    <section class="bg-slate-50 py-20">
        <div class="mx-auto max-w-7xl px-6">

            <header class="max-w-2xl">
                <span class="text-sm md:text-base lg:text-lg font-semibold uppercase tracking-[0.25em] text-orange-500">
                    {t.whyImportant.eyebrow}
                </span>

                <h2 class="mt-4 text-xl md:text-2xl lg:text-4xl font-bold text-amber-950">
                    <Fragment set:html={t.whyImportant.heading} />
                </h2>

                <p class="mt-6 text-sm md:text-base lg:text-lg text-slate-600">
                    {t.whyImportant.subtitle}
                </p>
            </header>

            <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
                {
                    reasons.map((item) => (
                        <article class="group rounded-3xl border border-slate-200 bg-white p-8 transition-all duration-300 hover:-translate-y-2 hover:shadow-xl">
                            <div class="flex h-12 w-12 md:h-16 md:w-16 items-center justify-center rounded-2xl bg-orange-100">
                                <Icon name={item.icon} class="h-8 w-8 text-orange-600" />
                            </div>
                            <h3 class="mt-6 text-xl md:text-2xl font-bold text-amber-950">{item.title}</h3>
                            <p class="mt-4 text-sm md:text-base lg:text-lg leading-relaxed text-slate-600">{item.description}</p>
                        </article>
                    ))
                }
            </div>

        </div>
    </section>

    <!-- PENGUJIAN -->
    <section class="bg-white py-20 md:py-24">
        <div class="mx-auto max-w-7xl px-6">

            <header class="mx-auto max-w-4xl text-center">
                <span class="text-sm md:text-base font-semibold uppercase tracking-[0.25em] text-orange-500">
                    {t.testing.eyebrow}
                </span>
                <h2 class="mt-4 text-2xl font-bold text-amber-950 md:text-3xl lg:text-4xl">
                    {t.testing.heading}
                </h2>
                <p class="mt-6 text-sm md:text-base lg:text-lg leading-relaxed text-slate-600">
                    {t.testing.subtitle}
                </p>
            </header>

            <div class="mt-16 grid gap-12 lg:grid-cols-2 lg:items-center">

                <div class="space-y-8">
                    {
                        t.testing.items.map((item) => (
                            <article class="group border-b border-slate-200 pb-8">
                                <div class="flex gap-5 items-start">
                                    <span class="text-4xl font-bold text-orange-500 lg:text-5xl">{item.number}</span>
                                    <div>
                                        <h3 class="text-base md:text-xl font-bold text-amber-950 transition group-hover:text-orange-500">
                                            {item.title}
                                        </h3>
                                        <p class="mt-3 text-sm md:text-base lg:text-lg leading-relaxed text-slate-600">
                                            {item.description}
                                        </p>
                                    </div>
                                </div>
                            </article>
                        ))
                    }
                </div>

                <div>
                    <div class="grid grid-cols-2 gap-4">
                        {
                            testingImages.map((item, i) => (
                                <img
                                    src={item.image.src}
                                    alt={item.alt}
                                    class={`w-full rounded-3xl object-cover shadow-lg ${i === 0 || i === 3 ? 'h-44 md:h-56' : 'h-56 md:h-72'}`}
                                />
                            ))
                        }
                    </div>
                </div>

            </div>

        </div>
    </section>

    <!-- KEUNGGULAN -->
    <section class="bg-slate-50 py-18">
        <div class="mx-auto max-w-5xl px-6">

            <header class="text-center">
                <span class="font-semibold uppercase tracking-[0.2em] text-sm md:text-md lg:text-lg text-orange-500">
                    {t.advantages.eyebrow}
                </span>
                <h2 class="mt-4 text-2xl font-bold text-amber-950 md:text-4xl">
                    {t.advantages.heading}
                </h2>
                <p class="mx-auto mt-6 text-sm md:text-lg max-w-3xl text-slate-600">
                    {t.advantages.subtitle}
                </p>
            </header>

            <div class="mt-12 md:mt-16">
                <div class="space-y-10">
                    {
                        workflow.map((item) => (
                            <article class="relative pl-16">
                                <div class="absolute left-0 top-0 flex h-10 w-10 md:h-12 md:w-12 items-center justify-center rounded-full border-green-700 bg-green-600 font-bold text-white">
                                    <Icon name={item.icon} class="h-6 w-6 md:h-8 md:w-8 text-white" />
                                </div>
                                <h3 class="text-lg md:text-xl lg:text-2xl font-bold text-amber-950">{item.title}</h3>
                                <p class="mt-3 text-sm md:text-md lg:text-lg text-slate-600 leading-relaxed">{item.description}</p>
                            </article>
                        ))
                    }
                </div>
            </div>

        </div>
    </section>

    <!-- TEKNOLOGI -->
    <section class="bg-white py-18 md:py-24">
        <div class="mx-auto max-w-7xl px-6">

            <header class="mx-auto max-w-4xl text-center">
                <span class="text-sm md:text-md lg:text-lg font-semibold uppercase tracking-[0.3em] text-orange-500">
                    {t.technologies.eyebrow}
                </span>
                <h2 class="mt-4 text-2xl font-bold text-amber-950 md:text-4xl">
                    {t.technologies.heading}
                </h2>
                <p class="mt-6 text-sm md:text-base leading-relaxed text-slate-600 lg:text-lg">
                    {t.technologies.subtitle}
                </p>
            </header>

            <div class="mt-20 space-y-24">
                {
                    technologies.map((item, index) => (
                        <article class={`grid gap-10 lg:grid-cols-2 lg:items-center ${index % 2 !== 0 ? "lg:[&>*:first-child]:order-2" : ""}`}>

                            <div class="relative">
                                <img src={item.image.src} alt={item.title} class="h-75 md:h-110 w-full rounded-4xl object-cover shadow-xl" />
                                <div class="absolute bottom-6 left-6 rounded-2xl bg-white/95 px-4 py-2 md:px-5 md:py-3 backdrop-blur shadow-lg">
                                    <span class="text-sm font-semibold text-orange-500">{t.technologies.badgeLabel}</span>
                                </div>
                            </div>

                            <div>
                                <h3 class="text-xl font-bold text-amber-950 md:text-2xl lg:text-3xl">{item.title}</h3>
                                <p class="mt-4 text-base leading-relaxed text-slate-600 md:text-lg">{item.description}</p>

                                <div class="mt-6 grid gap-4">
                                    {
                                        item.benefits.map((benefit) => (
                                            <div class="flex items-center gap-3">
                                                <div class="flex h-8 w-8 items-center justify-center rounded-full bg-orange-100 text-orange-500 font-bold">✓</div>
                                                <span class="text-sm md:text-base text-slate-700 font-medium">{benefit}</span>
                                            </div>
                                        ))
                                    }
                                </div>
                            </div>

                        </article>
                    ))
                }
            </div>

        </div>
    </section>

    <!-- HASIL -->
    <section class="bg-slate-50 py-20 md:py-24">
        <div class="mx-auto max-w-4xl px-6">
            <div class="grid gap-16">
                <div>
                    <span class="font-semibold text-base md:text-lg uppercase tracking-[0.25em] text-orange-500">
                        {t.results.eyebrow}
                    </span>
                    <h2 class="mt-4 text-2xl font-bold text-amber-950 md:text-3xl lg:text-4xl">
                        {t.results.heading}
                    </h2>
                    <p class="mt-6 text-sm lg:text-lg leading-relaxed text-slate-600 md:text-base">
                        {t.results.subtitle}
                    </p>

                    <div class="mt-10 space-y-6">
                        {
                            t.results.items.map((item) => (
                                <div class="flex gap-4">
                                    <div class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-orange-100">✓</div>
                                    <div>
                                        <h3 class="text-base md:text-lg lg:text-xl font-semibold text-amber-950">{item.title}</h3>
                                        <p class="mt-2 text-sm md:text-base lg:text-lg text-slate-600">{item.description}</p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ STYLE -->
    <style>
        .faq-item summary::-webkit-details-marker { display: none; }
        .faq-item[open] .faq-icon { transform: rotate(45deg); }
        .faq-item div { display: grid; grid-template-rows: 0fr; transition: all 0.3s ease; }
        .faq-item[open] div { grid-template-rows: 1fr; }
        .faq-item summary:hover h3 { color: #92400e; }
    </style>

    <!-- FAQ -->
    <section id="faq" aria-labelledby="faq-heading" class="bg-white py-10 lg:py-24">
        <div class="mx-auto max-w-6xl px-6">

            <header class="mb-16 text-center">
                <h2 id="faq-heading" class="text-xl font-bold tracking-tight text-amber-950 md:text-2xl lg:text-4xl">
                    {t.faq.heading}
                </h2>
                <p class="mx-auto mt-6 max-w-4xl text-sm md:text-md lg:text-xl leading-relaxed text-slate-600">
                    {t.faq.subtitle}
                </p>
            </header>

            <div class="space-y-0">
                {
                    t.faq.items.map((faq) => (
                        <details class="faq-item border-t border-slate-300 py-2">
                            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left">
                                <h3 class="text-md font-semibold text-amber-950 md:text-xl">{faq.question}</h3>
                                <span class="faq-icon flex h-10 w-10 items-center justify-center text-4xl font-light text-black transition-transform">+</span>
                            </summary>
                            <div class="max-w-5xl pb-8 pr-12">
                                <p class="text-sm md:text-lg leading-relaxed text-slate-700">{faq.answer}</p>
                            </div>
                        </details>
                    ))
                }
                <div class="border-t border-slate-300"></div>
            </div>

        </div>
    </section>

    <!-- CTA -->
    <section class="bg-white py-14 md:py-24 text-center text-amber-950">
        <div class="mx-auto max-w-4xl px-6">

            <h2 class="text-2xl font-bold md:text-3xl lg:text-5xl">
                {t.cta.heading}
            </h2>

            <p class="mt-6 text-md md:text-lg lg:text-xl text-slate-700">
                <Fragment set:html={t.cta.description} />
            </p>

            <a 
                href="https://wa.me/6281376928398"
                target="_blank"
                class="inline-flex mt-10 items-center gap-2 rounded-full bg-green-600 px-6 py-2 md:px-7 md:py-3 text-xs md:text-lg font-bold tracking-wide text-white transition hover:bg-green-700"
            >
                <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
                </svg>
                {t.cta.buttonLabel}
            </a>

        </div>
    </section>

	<Footer />
</Layout>
