---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { Icon } from 'astro-icon/components'
import HeroImage from "../../images/hero.jpeg";
import { Image } from "astro:assets";
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const reasons = [
  {
    icon: "heroicons:shield-check",
    title: "Menjaga Keselamatan",
    description:
      "Mencegah potensi kegagalan struktur yang dapat membahayakan penghuni bangunan.",
  },
  {
    icon: "heroicons:building-office",
    title: "Mengetahui Kondisi Aktual",
    description:
      "Memahami kesehatan struktur berdasarkan data dan hasil pengujian lapangan.",
  },
  {
    icon: "heroicons:magnifying-glass",
    title: "Deteksi Dini Kerusakan",
    description:
      "Mengidentifikasi area kritis sebelum berkembang menjadi masalah besar.",
  },
  {
    icon: "heroicons:scale",
    title: "Kepatuhan Regulasi",
    description:
      "Memenuhi persyaratan teknis dan administrasi seperti SLF maupun kebutuhan legal lainnya.",
  },
];

const benefits = [
  {
    title: "Rekomendasi Teknis yang Akurat",
    description:
      "Laporan berbasis data lapangan dan analisis struktur sehingga keputusan perbaikan lebih tepat.",
  },
  {
    title: "Mengurangi Risiko Kegagalan Struktur",
    description:
      "Potensi kerusakan dapat diidentifikasi lebih awal sebelum menjadi masalah besar.",
  },
  {
    title: "Memenuhi Persyaratan Regulasi",
    description:
      "Mendukung kebutuhan SLF, PBG, dan dokumen teknis lainnya.",
  },
  {
    title: "Efisiensi Biaya Perawatan",
    description:
      "Menghindari pengeluaran besar akibat kerusakan yang tidak terdeteksi sejak dini.",
  },
];

const tests = [
  {
    number: "01",
    title: "Inspeksi Visual",
    description:
      "Pemetaan elemen struktur untuk mendeteksi retak, deformasi, serta indikasi penurunan fondasi sebelum dilakukan pengujian lanjutan.",
  },
  {
    number: "02",
    title: "Pengujian Material",
    description:
      "Pengujian Non-Destructive Test (NDT) seperti Hammer Test, UPV, dan Core Drill untuk memperoleh data kuat tekan beton aktual.",
  },
  {
    number: "03",
    title: "Analisis & Hitung",
    description:
      "Komputasi kapasitas daya dukung bangunan menggunakan perangkat lunak analisis struktur untuk mengevaluasi beban riil.",
  },
  {
    number: "04",
    title: "Evaluasi Standar",
    description:
      "Membandingkan hasil analisis dengan standar keamanan, regulasi bangunan, serta persyaratan kelayakan yang berlaku.",
  },
];

const workflow = [
  {
    icon: "heroicons:shield-check",
    title: "Akurasi dan Kredibilitas Tinggi",
    description:
      "Dilengkapi peralatan pengujian canggih (NDT) dan metode analisis terkini, kami memberikan hasil audit yang akurat sebagai dasar kuat untuk pengambilan keputusan renovasi.",
  },
  {
    icon: "heroicons:shield-check",
    title: "Tim Insinyur Tersertifikasi",
    description:
      "Didukung oleh tim insinyur dan teknisi bersertifikat internasional di bidang NDT.",
  },
  {
    icon: "heroicons:shield-check",
    title: "Peralatan Terbaru",
    description:
      "Menggunakan peralatan pengujian paling mutakhir yang terkalibrasi secara berkala.",
  },
   {
    icon: "heroicons:shield-check",
    title: "Laporan & Dukungan",
    description:
      "Menyajikan laporan digital interaktif dan dukungan konsultasi teknis berkelanjutan.",
  },
  {
    icon: "heroicons:shield-check",
    title: "Solusi Komprehensif (End-to-End)",
    description:
      "Kami tidak hanya mencari masalah, tetapi menyediakan konsultasi lanjutan dan strategi implementasi untuk perbaikan (retrofitting) yang dibutuhkan.",
  },
];

const technologies = [
  {
    title: "Ultrasonic Pulse Velocity (UPV)",
    description:
      "Teknologi Ultrasonic Pulse Velocity (UPV) bekerja dengan memancarkan gelombang ultrasonik melalui elemen beton. Sensor canggih akan mengukur kecepatan rambat gelombang tersebut dari satu titik ke titik lainnya. Metode ini sangat efektif untuk mendeteksi retak internal, keropos (void), dan area dengan penurunan kualitas material yang tidak terlihat di permukaan. Prosesnya berlangsung cepat, sangat akurat, dan sepenuhnya non-invasif, memberikan gambaran utuh tentang kesehatan beton tanpa meninggalkan jejak.",
    benefits: [
      "Deteksi void",
      "Pengujian non-destruktif",
      "Hasil cepat dan akurat",
    ],
    image: HeroImage,
  },

  {
    title: "Ground Penetrating Radar (GPR)",
    description:
      "teknologi pemindaian canggih yang mampu memvisualisasikan apa yang ada di balik permukaan beton, dinding, dan lantai. Alat ini memancarkan gelombang radar frekuensi tinggi dan menganalisis pantulannya untuk menciptakan peta citra bawah permukaan secara real-time. Dengan GPR, kami dapat secara akurat memetakan lokasi dan kedalaman tulangan baja, mengidentifikasi keberadaan pipa utilitas, mendeteksi rongga udara atau delaminasi, serta menemukan anomali lain yang tersembunyi.",
    benefits: [
      "Mengetahui posisi tulangan",
      "Tanpa pembongkaran",
      "Visualisasi bawah permukaan",
    ],
    image: HeroImage,
  },

  {
    title: "Building Information Modeling (BIM)",
    description:
      "Digitalisasi struktur bangunan dalam model 3D untuk membantu analisis, simulasi, dan pengambilan keputusan berbasis data. Melalui model BIM ini, pengelola gedung dapat memvisualisasikan lokasi anomali, memahami dampak potensialnya, dan merencanakan jadwal maintenance prediktif secara lebih efisien.",
    benefits: [
      "Visualisasi 3D",
      "Analisis terintegrasi",
      "Dokumentasi digital",
    ],
    image: HeroImage,
  },

  {
    title: "Thermal Imaging & Infrared Thermography",
    description:
      "Pendeteksian perbedaan temperatur untuk mengidentifikasi area yang berpotensi mengalami kerusakan, kebocoran, atau anomali struktural. Perbedaan suhu pada permukaan dapat menunjukkan adanya kelembaban tersembunyi, kebocoran air, delaminasi pada lapisan eksterior, atau kegagalan sistem insulasi. nspeksi thermal imaging berlangsung cepat, non-kontak, dan memberikan data visual yang jelas untuk analisis lebih lanjut.",
    benefits: [
      "Inspeksi cepat",
      "Deteksi kebocoran",
      "Tanpa kontak langsung",
    ],
    image: HeroImage,
  },
];

const faqs = [
  {
    question: "Apa bedanya inspeksi biasa dengan audit + hitung struktur?",
    answer:
      "Inspeksi visual hanya melihat kerusakan luar. Hitung struktur memasukkan data lapangan ke dalam pemodelan komputasi untuk mengetahui sisa kapasitas beban aktual bangunan secara matematis.",
  },
  {
    question: "Kapan sebuah bangunan wajib melakukan audit struktur?",
    answer:
      "Saat muncul indikasi kerusakan struktural (retak pada balok/kolom, fondasi turun), akan ada alih fungsi bangunan (penambahan beban operasional), rencana penambahan lantai, atau pengecekan pasca-bencana.",
  },
  {
    question: "Benarkah hitung struktur bisa menekan biaya perbaikan?",
    answer:
      "Sangat benar. Dengan hitungan akurat, perbaikan hanya difokuskan pada elemen yang terbukti melemah. Ini mencegah rekomendasi overkill seperti pembongkaran area yang sebenarnya masih aman.",
  },
  {
    question:
      "Dokumen apa saja yang akan saya terima di akhir proyek?",
    answer:
      "Anda akan menerima Laporan Evaluasi Teknis, Rekomendasi Metode Perbaikan, serta RAB/BoQ detail yang siap digunakan sebagai panduan lelang kontraktor pelaksana perbaikan.",
  },
  {
    question:
      "Berapa lama waktu yang dibutuhkan untuk audit struktur?",
    answer:
      "Dengan teknologi terkini, survei lapangan untuk gedung 10-15 lantai umumnya dapat diselesaikan dalam 3-5 hari kerja. Laporan komprehensif berbasis digital akan tersedia dalam 7-10 hari kerja setelah survei selesai, jauh lebih cepat dibandingkan metode konvensional yang memakan waktu berminggu-minggu.",
  },
  {
    question:
      "Apakah pengujian akan mengganggu operasional gedung?",
    answer:
      "Sama sekali tidak. Seluruh metode pengujian kami bersifat non-invasif, tidak bising, dan bersih. Kami dapat berkoordinasi untuk melakukan pekerjaan di luar jam operasional atau pada waktu yang paling tidak mengganggu untuk memastikan kelancaran aktivitas di dalam gedung Anda.",
  },
];

---

<Layout>
	<Navbar />
    <!-- HERO -->
    <section class="relative h-140 lg:h-170 overflow-hidden">

    <!-- Background Image -->
    <img
        src={HeroImage.src}
        alt=""
        class="absolute inset-0 h-full w-full object-cover"
    />
    <div class="absolute inset-0 bg-black/70"></div>

    <!-- Content -->
    <div
        class="relative z-10 flex h-full items-center justify-start"
    >
        <div class="mx-10 lg:mx-40 max-w-5xl px-6 text-left text-white">

        <h1
            class="text-[27px] font-bold leading-tight md:text-4xl lg:text-5xl"
        >
        Jasa Audit & Hitung Struktur <br> Bangunan 
        Profesional
        </h1>

        <p
            class="mt-8 max-w-3xl text-sm leading-relaxed text-white/90 md:text-xl"
        >Pastikan keamanan gedung dan hindari pembengkakan biaya perbaikan dengan evaluasi dan perhitungan daya dukung struktur yang akurat dan independen.

        </p>

        </div>
    </div>

    </section>

    <!-- APA ITU AUDIT STRUKTUR -->
     <section class="bg-white py-20 lg:py-28">
        <div
            class="mx-auto max-w-7xl px-6"
        >

            <div
            class="
                grid
                gap-14
                lg:grid-cols-2
                lg:items-center
            "
            >

            <!-- LEFT -->

            <div>

                <span
                class="
                    text-sm md:text-base lg:text-lg
                    font-semibold
                    uppercase
                    tracking-[0.25em]
                    text-orange-500
                "
                >
                Audit Struktur
                </span>

                <h1
                class="
                    mt-4
                    text-xl
                    md:text-2xl
                    lg:text-4xl
                    font-bold
                    leading-tight
                    text-amber-950
                "
                >
                Apa Itu Audit Struktur Bangunan?
                </h1>

                <p
                class="
                    mt-8
                    text-sm
                    leading-relaxed
                    text-slate-600
                    md:text-md
                    lg:text-lg
                "
                >
                Audit struktur merupakan proses pemeriksaan
                menyeluruh terhadap kondisi bangunan untuk
                mengetahui tingkat keamanan, kelayakan fungsi,
                serta kemampuan struktur dalam menahan beban
                sesuai standar yang berlaku.
                </p>

                <p
                class="
                    mt-6
                    text-base
                    leading-relaxed
                    text-slate-600
                    md:text-lg
                "
                >
                Melalui proses evaluasi teknis yang sistematis,
                tim engineer kami dapat mengidentifikasi
                kerusakan, penurunan mutu material, serta
                memberikan rekomendasi perbaikan atau
                perkuatan yang diperlukan.
                </p>

            </div>

            <!-- RIGHT -->

            <div
                class="relative"
            >

                <div
                class="
                    absolute
                    -bottom-6
                    -left-6
                    h-full
                    w-full
                    rounded-3xl
                    bg-orange-50
                "
                ></div>

                <Image
                src={HeroImage}
                alt="Audit Struktur Bangunan"
                width={1000}
                loading="eager"
                class="
                    relative
                    z-10
                    rounded-3xl
                    object-cover
                    shadow-2xl
                "
                />

            </div>

            </div>

        </div>
    </section>

    <!-- MENGAPA AUDIT STRUKTUR PENTING -->
     <section class="bg-slate-50 py-20">
        <div class="mx-auto max-w-7xl px-6">

            <header
            class="max-w-2xl"
            >

            <span
                class="
                text-sm
                md:text-base
                lg:text-lg
                font-semibold
                uppercase
                tracking-[0.25em]
                text-orange-500
                "
            >
                Mengapa Perlu Melakukan Audit Struktur?
            </span>

            <h2
                class="
                mt-4
                text-xl md:text-2xl lg:text-4xl
                font-bold
                text-amber-950
                "
            >
                Investasi untuk Keamanan
                dan Umur Bangunan Anda
            </h2>

            <p
                class="
                mt-6
                text-sm
                md:text-base
                lg:text-lg
                text-slate-600
                "
            >
                Audit struktur tidak hanya untuk memenuhi
                regulasi, tetapi juga melindungi aset,
                operasional bisnis, dan keselamatan penghuni.
            </p>

            </header>

            <div
            class="
                mt-14
                grid
                gap-6
                md:grid-cols-2
                xl:grid-cols-4
            "
            >

            {
                reasons.map((item) => (

                <article
                    class="
                    group
                    rounded-3xl
                    border
                    border-slate-200
                    bg-white
                    p-8
                    transition-all
                    duration-300
                    hover:-translate-y-2
                    hover:shadow-xl
                    "
                >

                    <div
                    class="
                        flex
                        h-12
                        w-12
                        md:h-16
                        md:w-16
                        items-center
                        justify-center
                        rounded-2xl
                        bg-orange-100
                    "
                    >

                    <Icon
                        name={item.icon}
                        class="
                        h-8
                        w-8
                        text-orange-600
                        "
                    />

                    </div>

                    <h3
                    class="
                        mt-6
                        text-xl
                        md:text-2xl
                        font-bold
                        text-amber-950
                    "
                    >
                    {item.title}
                    </h3>

                    <p
                    class="
                        mt-4
                        text-sm
                        md:text-base
                        lg:text-lg
                        leading-relaxed
                        text-slate-600
                    "
                    >
                    {item.description}
                    </p>

                </article>

                ))
            }

            </div>

        </div>
    </section>

    <!-- PENGUJIAN -->
    <section
    class="
        bg-white
        py-20
        md:py-24
    "
    >

    <div
        class="mx-auto max-w-7xl px-6"
    >

        <header
        class="mx-auto max-w-4xl text-center"
        >

        <span
            class="
            text-sm
            md:text-base
            font-semibold
            uppercase
            tracking-[0.25em]
            text-orange-500
            "
        >
            Metode Pengujian
        </span>

        <h2
            class="
            mt-4
            text-2xl
            font-bold
            text-amber-950
            md:text-3xl
            lg:text-4xl
            "
        >
            Jenis Pengujian yang Kami Lakukan
        </h2>

        <p
            class="
            mt-6
            text-sm
            md:text-base
            lg:text-lg
            leading-relaxed
            text-slate-600
            "
        >
            Kombinasi inspeksi lapangan, pengujian material,
            dan analisis rekayasa untuk menghasilkan evaluasi
            struktur yang akurat dan dapat dipertanggungjawabkan.
        </p>

        </header>

        <div
        class="
            mt-16
            grid
            gap-12
            lg:grid-cols-2
            lg:items-center
        "
        >

        <!-- LEFT -->
        <div
            class="space-y-8"
        >

            {
            tests.map((item) => (

                <article
                class="
                    group
                    border-b
                    border-slate-200
                    pb-8
                "
                >

                <div
                    class="
                    flex
                    gap-5
                    items-start
                    "
                >

                    <span
                    class="
                        text-4xl
                        font-bold
                        text-orange-500
                        lg:text-5xl
                    "
                    >
                    {item.number}
                    </span>

                    <div>

                    <h3
                        class="
                        text-base
                        md:text-xl
                        font-bold
                        text-amber-950
                        transition
                        group-hover:text-orange-500
                        "
                    >
                        {item.title}
                    </h3>

                    <p
                        class="
                        mt-3
                        text-sm
                        md:text-base
                        lg:text-lg
                        leading-relaxed
                        text-slate-600
                        "
                    >
                        {item.description}
                    </p>

                    </div>

                </div>

                </article>

            ))
            }

        </div>

         <!-- IMAGE GRID -->
            <div>

                <div
                class="
                    grid
                    grid-cols-2
                    gap-4
                "
                >

                <img
                    src={HeroImage.src}
                    alt="Audit Struktur Gedung"
                    class="
                    h-44
                    md:h-56
                    w-full
                    rounded-3xl
                    object-cover
                    shadow-lg
                    "
                />

                <img
                    src={HeroImage.src}
                    alt="Pengujian Struktur Bangunan"
                    class="
                    h-56
                    md:h-72
                    w-full
                    rounded-3xl
                    object-cover
                    shadow-lg
                    "
                />

                <img
                    src={HeroImage.src}
                    alt="Tim Audit Struktur"
                    class="
                    h-56
                    md:h-72
                    w-full
                    rounded-3xl
                    object-cover
                    shadow-lg
                    "
                />

                <img
                    src={HeroImage.src}
                    alt="Pemeriksaan Konstruksi"
                    class="
                    h-44
                    md:h-56
                    w-full
                    rounded-3xl
                    object-cover
                    shadow-lg
                    "
                />

                </div>

            </div>

        </div>

    </div>

    </section>

    <!-- KEUNGGULAN -->
    <section class="bg-slate-50 py-18">

        <div class="mx-auto max-w-5xl px-6">

            <header class="text-center">

            <span
                class="font-semibold uppercase tracking-[0.2em] text-sm md:text-md lg:text-lg text-orange-500"
            >
                Keunggulan
            </span>

            <h2
                class="mt-4 text-2xl font-bold text-amber-950 md:text-4xl"
            >
                Keunggulan Layanan Audit Struktur Kami
            </h2>

            <p
                class="mx-auto mt-6 text-sm md:text-lg max-w-3xl text-slate-600"
            >
                Kami menyediakan layanan audit struktur yang memiliki keunggulan seperti:
            </p>

            </header>

            <div class="mt-12 md:mt-16">

            <!-- Workflow -->
            <div
                class="
                space-y-10
                "
            >

                {
                workflow.map((item) => (

                    <article
                    class="
                        relative
                        pl-16
                    "
                    >

                    {/* Icon */}
                    <div
                        class="
                        absolute
                        left-0
                        top-0
                        flex
                        h-10
                        w-10
                        md:h-12
                        md:w-12
                        items-center
                        justify-center
                        rounded-full
                         border-green-700
                            bg-green-600
                        font-bold
                        text-white
                        "
                    >
                        <Icon
                            name={item.icon}
                            class="
                            h-6
                            w-6
                            md:h-8
                            md:w-8
                            text-white
                            "
                        />
                    </div>

                    <h3
                        class="
                        text-lg
                        md:text-xl
                        lg:text-2xl
                        font-bold
                        text-amber-950
                        "
                    >
                        {item.title}
                    </h3>

                    <p
                        class="
                        mt-3
                        text-sm
                        md:text-md
                        lg:text-lg
                        text-slate-600
                        leading-relaxed
                        "
                    >
                        {item.description}
                    </p>

                    </article>

                ))
                }

            </div>

            </div>

        </div>

    </section>

    <!-- TEKNOLOGI -->
    <section class="bg-white py-18 md:py-24">

        <div
            class="mx-auto max-w-7xl px-6"
        >

            <header
            class="mx-auto max-w-4xl text-center"
            >

            <span
                class="
                text-sm
                md:text-md
                lg:text-lg
                font-semibold
                uppercase
                tracking-[0.3em]
                text-orange-500
                "
            >
                Teknologi Audit Struktur
            </span>

            <h2
                class="
                mt-4
                text-2xl
                font-bold
                text-amber-950
                md:text-4xl
                "
            >
                Teknologi Modern yang Kami Gunakan
            </h2>

            <p
                class="
                mt-6
                text-sm
                md:text-base
                leading-relaxed
                text-slate-600
                lg:text-lg
                "
            >
                Kami menggabungkan teknologi inspeksi lapangan,
                pengujian non-destruktif, dan analisis digital
                untuk menghasilkan data dan rekomendasi teknis yang akurat.
            </p>

            </header>

            <div
            class="mt-20 space-y-24"
            >

            {
                technologies.map((item, index) => (

                <article
                    class={`
                    grid
                    gap-10
                    lg:grid-cols-2
                    lg:items-center
                    ${
                        index % 2 !== 0
                        ? "lg:[&>*:first-child]:order-2"
                        : ""
                    }
                    `}
                >

                    <!-- IMAGE -->

                    <div
                    class="relative"
                    >

                    <img
                        src={item.image.src}
                        alt={item.title}
                        class="
                        h-75
                        md:h-110
                        w-full
                        rounded-4xl
                        object-cover
                        shadow-xl
                        "
                    />

                    <div
                        class="
                        absolute
                        bottom-6
                        left-6
                        rounded-2xl
                        bg-white/95
                        px-4
                        py-2
                        md:px-5
                        md:py-3
                        backdrop-blur
                        shadow-lg
                        "
                    >

                        <span
                        class="
                            text-sm
                            font-semibold
                            text-orange-500
                        "
                        >
                        Advanced Technology
                        </span>

                    </div>

                    </div>

                    <!-- CONTENT -->

                    <div>

                    <h3
                        class="
                        text-xl
                        font-bold
                        text-amber-950
                        md:text-2xl
                        lg:text-3xl
                        "
                    >
                        {item.title}
                    </h3>

                    <p
                        class="
                        mt-4
                        text-base
                        leading-relaxed
                        text-slate-600
                        md:text-lg
                        "
                    >
                        {item.description}
                    </p>

                    <div
                        class="
                        mt-6
                        grid
                        gap-4
                        "
                    >

                        {
                        item.benefits.map((benefit) => (

                            <div
                            class="
                                flex
                                items-center
                                gap-3
                            "
                            >

                            <div
                                class="
                                flex
                                h-8
                                w-8
                                items-center
                                justify-center
                                rounded-full
                                bg-orange-100
                                text-orange-500
